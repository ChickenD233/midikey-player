<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">

      <SolidColorBrush x:Key="BrushCanvas"       Color="#F4F6F9"/>
      <SolidColorBrush x:Key="BrushSurface"      Color="#FFFFFF"/>
      <SolidColorBrush x:Key="BrushSurfaceAlt"   Color="#F8FAFC"/>
      <SolidColorBrush x:Key="BrushSurfaceSunken" Color="#F7F8FA"/>
      <SolidColorBrush x:Key="BrushBorder"       Color="#E4E8EE"/>
      <SolidColorBrush x:Key="BrushBorderStrong" Color="#D3DAE3"/>

      <SolidColorBrush x:Key="BrushText"          Color="#1F2933"/>
      <SolidColorBrush x:Key="BrushTextSecondary" Color="#5B6673"/>
      <SolidColorBrush x:Key="BrushTextMuted"     Color="#6B7480"/>

      <SolidColorBrush x:Key="BrushAccent"         Color="#2A7D4F"/>
      <SolidColorBrush x:Key="BrushAccentHover"    Color="#236F43"/>
      <SolidColorBrush x:Key="BrushAccentPressed"  Color="#1F6540"/>
      <SolidColorBrush x:Key="BrushAccentDisabled" Color="#AECBBC"/>
      <SolidColorBrush x:Key="BrushAccentSoft"     Color="#E8F3EC"/>
      <SolidColorBrush x:Key="BrushOnAccent"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushAccentText"     Color="#FFFFFF"/>

      <SolidColorBrush x:Key="BrushSuccess" Color="#1E7A3C"/>
      <SolidColorBrush x:Key="BrushWarn"    Color="#B25A00"/>
      <SolidColorBrush x:Key="BrushDanger"  Color="#C0392B"/>

      <SolidColorBrush x:Key="BrushDangerSoft"   Color="#FDF1EF"/>
      <SolidColorBrush x:Key="BrushDangerBorder" Color="#F0CFC9"/>
      <SolidColorBrush x:Key="BrushDangerText"   Color="#A32B22"/>
      <SolidColorBrush x:Key="BrushWarnSoft"     Color="#FFF7E8"/>
      <SolidColorBrush x:Key="BrushWarnBorder"   Color="#F0DCB4"/>
      <SolidColorBrush x:Key="BrushInfoSoft"     Color="#EAF3FF"/>
      <SolidColorBrush x:Key="BrushInfoBorder"   Color="#BBD6F5"/>
      <SolidColorBrush x:Key="BrushInfoText"     Color="#1B4F91"/>

      <SolidColorBrush x:Key="BrushCountdownChrome" Color="#FFF3E4D8"/>

      <SolidColorBrush x:Key="BrushKeyWhite"   Color="#FFFFFF"/>
      <SolidColorBrush x:Key="BrushKeyBlack"   Color="#E4EAF2"/>
      <SolidColorBrush x:Key="BrushRollBg"     Color="#F7F9FC"/>
      <SolidColorBrush x:Key="BrushRollGrid"   Color="#E9EEF5"/>
      <SolidColorBrush x:Key="BrushRollBeat"   Color="#DCE4EE"/>
      <SolidColorBrush x:Key="BrushRollBar"    Color="#C9D5E3"/>
      <SolidColorBrush x:Key="BrushRollOctave" Color="#E3E9F1"/>
      <SolidColorBrush x:Key="BrushRollRuler"  Color="#EEF3F9"/>
      <SolidColorBrush x:Key="BrushSkipNote"   Color="#C8D0D9"/>
      <SolidColorBrush x:Key="BrushDisabledFace" Color="#F3F5F8"/>
      <SolidColorBrush x:Key="BrushRollAccent" Color="#1F6FEB"/>
      <SolidColorBrush x:Key="BrushRollHover"  Color="#8FB4E8"/>
      <SolidColorBrush x:Key="BrushRollKeySel" Color="#C7DBFA"/>
      <SolidColorBrush x:Key="BrushRollReadout" Color="#E8F0FC"/>
      <SolidColorBrush x:Key="BrushRollReadoutBorder" Color="#C3D6F2"/>
      <SolidColorBrush x:Key="BrushRollMarquee" Color="#331F6FEB"/>

      <SolidColorBrush x:Key="BrushVoice0"  Color="#1660C8"/>
      <SolidColorBrush x:Key="BrushVoice1"  Color="#0F7A46"/>
      <SolidColorBrush x:Key="BrushVoice2"  Color="#8A6500"/>
      <SolidColorBrush x:Key="BrushVoice3"  Color="#C22B2B"/>
      <SolidColorBrush x:Key="BrushVoice4"  Color="#4C7A0A"/>
      <SolidColorBrush x:Key="BrushVoice5"  Color="#0D6E8C"/>
      <SolidColorBrush x:Key="BrushVoice6"  Color="#AE4A10"/>
      <SolidColorBrush x:Key="BrushVoice7"  Color="#7A45C8"/>
      <SolidColorBrush x:Key="BrushVoice8"  Color="#C0185E"/>
      <SolidColorBrush x:Key="BrushVoice9"  Color="#0E7A72"/>
      <SolidColorBrush x:Key="BrushVoice10" Color="#4A4ED0"/>
      <SolidColorBrush x:Key="BrushVoice11" Color="#96601A"/>

      <StaticResource x:Key="SplitButtonBackground" ResourceKey="BrushAccent"/>
      <StaticResource x:Key="SplitButtonBackgroundPointerOver" ResourceKey="BrushAccentHover"/>
      <StaticResource x:Key="SplitButtonBackgroundPressed" ResourceKey="BrushAccentPressed"/>
      <StaticResource x:Key="SplitButtonBackgroundDisabled" ResourceKey="BrushAccentDisabled"/>
      <StaticResource x:Key="SplitButtonForeground" ResourceKey="BrushAccentText"/>
      <StaticResource x:Key="SplitButtonForegroundPointerOver" ResourceKey="BrushAccentText"/>
      <StaticResource x:Key="SplitButtonForegroundPressed" ResourceKey="BrushAccentText"/>
      <StaticResource x:Key="SplitButtonForegroundDisabled" ResourceKey="BrushAccentText"/>

    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">

      <SolidColorBrush x:Key="BrushCanvas"       Color="#12161B"/>
      <SolidColorBrush x:Key="BrushSurface"      Color="#1A2027"/>
      <SolidColorBrush x:Key="BrushSurfaceAlt"   Color="#212831"/>
      <SolidColorBrush x:Key="BrushSurfaceSunken" Color="#151A20"/>
      <SolidColorBrush x:Key="BrushBorder"       Color="#2C343E"/>
      <SolidColorBrush x:Key="BrushBorderStrong" Color="#3B4551"/>

      <SolidColorBrush x:Key="BrushText"          Color="#E7ECF2"/>
      <SolidColorBrush x:Key="BrushTextSecondary" Color="#AAB4C0"/>
      <SolidColorBrush x:Key="BrushTextMuted"     Color="#93A0AE"/>

      <SolidColorBrush x:Key="BrushAccent"         Color="#3AA469"/>
      <SolidColorBrush x:Key="BrushAccentHover"    Color="#4FB57C"/>
      <SolidColorBrush x:Key="BrushAccentPressed"  Color="#2E8B57"/>
      <SolidColorBrush x:Key="BrushAccentDisabled" Color="#2C4A3B"/>
      <SolidColorBrush x:Key="BrushAccentSoft"     Color="#1D3227"/>
      <SolidColorBrush x:Key="BrushOnAccent"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushAccentText"     Color="#08120C"/>

      <SolidColorBrush x:Key="BrushSuccess" Color="#4ED8A0"/>
      <SolidColorBrush x:Key="BrushWarn"    Color="#FFB020"/>
      <SolidColorBrush x:Key="BrushDanger"  Color="#FF6B5E"/>

      <SolidColorBrush x:Key="BrushDangerSoft"   Color="#35201D"/>
      <SolidColorBrush x:Key="BrushDangerBorder" Color="#5A342C"/>
      <SolidColorBrush x:Key="BrushDangerText"   Color="#FF9E92"/>
      <SolidColorBrush x:Key="BrushWarnSoft"     Color="#33270F"/>
      <SolidColorBrush x:Key="BrushWarnBorder"   Color="#5C4A24"/>
      <SolidColorBrush x:Key="BrushInfoSoft"     Color="#152A42"/>
      <SolidColorBrush x:Key="BrushInfoBorder"   Color="#2C4E76"/>
      <SolidColorBrush x:Key="BrushInfoText"     Color="#9CC7FF"/>

      <SolidColorBrush x:Key="BrushCountdownChrome" Color="#FF2A1E14"/>

      <SolidColorBrush x:Key="BrushKeyWhite"   Color="#D8DEE6"/>
      <SolidColorBrush x:Key="BrushKeyBlack"   Color="#2A323C"/>
      <SolidColorBrush x:Key="BrushRollBg"     Color="#161B21"/>
      <SolidColorBrush x:Key="BrushRollGrid"   Color="#232A33"/>
      <SolidColorBrush x:Key="BrushRollBeat"   Color="#2A323C"/>
      <SolidColorBrush x:Key="BrushRollBar"    Color="#3A444F"/>
      <SolidColorBrush x:Key="BrushRollOctave" Color="#242B34"/>
      <SolidColorBrush x:Key="BrushRollRuler"  Color="#1C2229"/>
      <SolidColorBrush x:Key="BrushSkipNote"   Color="#4C5560"/>
      <SolidColorBrush x:Key="BrushDisabledFace" Color="#222932"/>
      <SolidColorBrush x:Key="BrushRollAccent" Color="#4C9AFF"/>
      <SolidColorBrush x:Key="BrushRollHover"  Color="#6FA8F0"/>
      <SolidColorBrush x:Key="BrushRollKeySel" Color="#2F4A6B"/>
      <SolidColorBrush x:Key="BrushRollReadout" Color="#1E2A3A"/>
      <SolidColorBrush x:Key="BrushRollReadoutBorder" Color="#33507A"/>
      <SolidColorBrush x:Key="BrushRollMarquee" Color="#404C9AFF"/>

      <SolidColorBrush x:Key="BrushVoice0"  Color="#4EA1FF"/>
      <SolidColorBrush x:Key="BrushVoice1"  Color="#4ED8A0"/>
      <SolidColorBrush x:Key="BrushVoice2"  Color="#FFD166"/>
      <SolidColorBrush x:Key="BrushVoice3"  Color="#F45B69"/>
      <SolidColorBrush x:Key="BrushVoice4"  Color="#9BD34E"/>
      <SolidColorBrush x:Key="BrushVoice5"  Color="#5CC8FF"/>
      <SolidColorBrush x:Key="BrushVoice6"  Color="#FF8A5C"/>
      <SolidColorBrush x:Key="BrushVoice7"  Color="#C792EA"/>
      <SolidColorBrush x:Key="BrushVoice8"  Color="#FF6E9C"/>
      <SolidColorBrush x:Key="BrushVoice9"  Color="#7FE0E8"/>
      <SolidColorBrush x:Key="BrushVoice10" Color="#B0A0FF"/>
      <SolidColorBrush x:Key="BrushVoice11" Color="#F2A65A"/>

      <StaticResource x:Key="SplitButtonBackground" ResourceKey="BrushAccent"/>
      <StaticResource x:Key="SplitButtonBackgroundPointerOver" ResourceKey="BrushAccentHover"/>
      <StaticResource x:Key="SplitButtonBackgroundPressed" ResourceKey="BrushAccentPressed"/>
      <StaticResource x:Key="SplitButtonBackgroundDisabled" ResourceKey="BrushAccentDisabled"/>
      <StaticResource x:Key="SplitButtonForeground" ResourceKey="BrushAccentText"/>
      <StaticResource x:Key="SplitButtonForegroundPointerOver" ResourceKey="BrushAccentText"/>
      <StaticResource x:Key="SplitButtonForegroundPressed" ResourceKey="BrushAccentText"/>
      <StaticResource x:Key="SplitButtonForegroundDisabled" ResourceKey="BrushAccentText"/>

    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="BrushRoleRhythm"  Color="#B2553A"/>   
  <SolidColorBrush x:Key="BrushRoleLow"     Color="#2F6D8E"/>   
  <SolidColorBrush x:Key="BrushRoleHarmony" Color="#3F7A4F"/>   
  <SolidColorBrush x:Key="BrushRoleLead"    Color="#8A4E9E"/>   
  <SolidColorBrush x:Key="BrushRoleOther"   Color="#6A6F78"/>   

  <FontFamily x:Key="FontUi">Microsoft YaHei UI, 微软雅黑, PingFang SC, Hiragino Sans GB, Noto Sans CJK SC, Source Han Sans SC, Segoe UI, Helvetica Neue, sans-serif</FontFamily>
  <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, SF Mono, Menlo, DejaVu Sans Mono, monospace</FontFamily>

  <x:Double x:Key="FontMicro">12.5</x:Double>
  <x:Double x:Key="FontCaption">12.5</x:Double>
  <x:Double x:Key="FontSmall">12.5</x:Double>
  <x:Double x:Key="FontBody">13.5</x:Double>
  <x:Double x:Key="FontTitle">15</x:Double>
  <x:Double x:Key="FontDisplay">22</x:Double>
  <x:Double x:Key="FontCountdown">32</x:Double>

  <CornerRadius x:Key="RadiusCard">10</CornerRadius>
  <CornerRadius x:Key="RadiusControl">8</CornerRadius>
  <Thickness x:Key="CardPadding">14,12</Thickness>
  <Thickness x:Key="CardGap">0,12,0,0</Thickness>

</ResourceDictionary>
