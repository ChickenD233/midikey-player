<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MidiKeyPlayer</RootNamespace>
    <AssemblyName>MidiKeyPlayer</AssemblyName>
    <Version>1.0.19</Version>
    <Company>MidiKeyPlayer</Company>
    <Product>MIDI 按键播放器</Product>
    <Description>导入 MIDI，把音符映射成键盘按键输出（Windows）</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- 发布形态：Windows x64、自包含、单文件。只影响 build / publish 产物，不改目标框架。
       写在这里（而不是只写在 build-win.sh 的命令行里），是为了让任何人直接执行
       `dotnet publish MidiKeyPlayer.csproj -c Release` 也得到同样唯一的 exe，不会再产出
       一堆松散文件。EnableCompressionInSingleFile 要求 SelfContained=true 才有意义。 -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- 不嵌入 PDB：单文件 exe 是唯一交付物，不带 .pdb 伴生文件。 -->
    <DebugType>none</DebugType>
    <!-- 裁剪。上一版关掉了，理由是「Avalonia 的 XAML 绑定走反射，DryWetMidi 大量用反射」。
         2026-09-16 重新测算并实测，改成「开裁剪 + 钉住反射相关程序集」：
           不裁剪            exe 45.6 MB
           只开裁剪          exe 22.1 MB
           裁剪 + 钉住表     exe 23.0 MB（比只开裁剪多 0.94 MB）
         钉住（TrimmerRootAssembly）让下面那几个程序集的类型与成员一个都不删，
         所以 XAML 反射绑定、DryWetMidi 的反射、以及 MainWindow.axaml.cs 里
         用 StackFrame.GetMethod() 取调用者名字的日志代码都不会被裁掉。
         实测记录（同一份源码，裁剪版与不裁剪版逐项对比）：
           1. 内置自检 23 条全部通过，退出码 0。
           2. 主窗与键位窗渲染成 PNG，逐字节相同（含载入三音轨 MIDI 并全部合奏）。
           3. 挂 Avalonia 日志监听器跑一遍，一条绑定错误都没有。
              负向对照能正常打出 Warning，证明这个监听器真的在收日志。
         复现步骤与完整记录见 midikey-audit\fixes\58-trim-verify.md。 -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <!-- 裁剪时钉住的程序集：这些程序集的类型与成员必须全部保留。
         MidiKeyPlayer —— XAML 里 {Binding} 的目标属性只被反射用到，按「入口点可达」裁会删掉；
         Avalonia 系列 —— 绑定引擎与 XAML 运行时；
         DryWetMidi    —— MIDI 解析与写出大量用反射。 -->
  <ItemGroup>
    <TrimmerRootAssembly Include="MidiKeyPlayer" />
    <TrimmerRootAssembly Include="Avalonia" />
    <TrimmerRootAssembly Include="Avalonia.Base" />
    <TrimmerRootAssembly Include="Avalonia.Controls" />
    <TrimmerRootAssembly Include="Avalonia.Desktop" />
    <TrimmerRootAssembly Include="Avalonia.Markup" />
    <TrimmerRootAssembly Include="Avalonia.Markup.Xaml" />
    <TrimmerRootAssembly Include="Avalonia.Skia" />
    <TrimmerRootAssembly Include="Avalonia.Themes.Fluent" />
    <TrimmerRootAssembly Include="Avalonia.Win32" />
    <TrimmerRootAssembly Include="Melanchall.DryWetMidi" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Melanchall.DryWetMidi" Version="7.2.0" />
  </ItemGroup>

  <!-- 原 App 图标资源。 -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- 合规文本：不再作为松散文件进包，一律嵌进 exe，随程序一起分发。
       用 AvaloniaResource（不用 EmbeddedResource）的理由：
         1. 用户要求资源能被程序直接读出来展示，AvaloniaResource 的资源可用
            Avalonia.Platform.AssetLoader.Open(new Uri("avares://MidiKeyPlayer/..."))) 打开，
            本仓库已有同样用法（MainWindow.axaml.cs 读 app.ico）。
         2. EmbeddedResource + LogicalName 只能靠 Assembly.GetManifestResourceStream 读，
            读取方式与现有代码不一致，Avalonia 打包单文件时也不参与其资源清单。
       每条都显式写 <Link>，不用通配符：<Link> 决定 avares 资源路径，同时让「源文件缺失」
       变成构建期硬错误，而不是悄悄少一个文件。Avalonia 官方确认支持 <Link>（LinkBase 不支持）。
       资源路径（供 .cs 读取，见 midikey-audit\fixes\32-single-exe.md）：
         avares://MidiKeyPlayer/Docs/更新说明.txt
         avares://MidiKeyPlayer/Docs/THIRD-PARTY-NOTICES.md
         avares://MidiKeyPlayer/Docs/LICENSE
       源文件路径：LICENSE 与 THIRD-PARTY-NOTICES.md 在仓库根，更新说明在项目内 docs/。
       源文件放在原处，只在这里挂进项目。
       示例曲目不进包（用户明确要求发布里不放任何示例）。 -->
  <ItemGroup>
    <AvaloniaResource Include="docs\更新说明.txt" Link="Docs/更新说明.txt" />
    <AvaloniaResource Include="..\THIRD-PARTY-NOTICES.md" Link="Docs/THIRD-PARTY-NOTICES.md" />
    <AvaloniaResource Include="..\LICENSE" Link="Docs/LICENSE" />
  </ItemGroup>

  <!-- 发布目录只留一个 exe。DryWetMidi 包里带 macOS / Linux 的原生库（.dylib / .so），
       它们不是 RID 限定的资产，publish 时会一起复制到 win-x64 输出，导致「多一个文件」。
       这里在发布清单算完之后把它们剔掉；build-win.sh 里另有一道检查兜底。 -->
  <Target Name="RemoveForeignNativeLibsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Extension)' == '.dylib' Or '%(Extension)' == '.so'" />
    </ItemGroup>
  </Target>

</Project>
