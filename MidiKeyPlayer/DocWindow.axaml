<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MidiKeyPlayer.DocWindow"
        Title="文档"
        Width="640" Height="520" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushCanvas}"
        FontFamily="{DynamicResource FontUi}">
  <Grid RowDefinitions="*,Auto" Margin="16">
    <TextBox Grid.Row="0" x:Name="TxtDoc" IsReadOnly="True" AcceptsReturn="True"
             TextWrapping="Wrap" VerticalContentAlignment="Top"
             Background="Transparent" BorderThickness="0" FontSize="{DynamicResource FontBody}"/>
    <Button Grid.Row="1" Content="关闭" Click="Close_Click" Padding="18,6"
            HorizontalAlignment="Right" Margin="0,12,0,0"/>
  </Grid>
</Window>
