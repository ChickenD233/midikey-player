<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MidiKeyPlayer"
        x:Class="MidiKeyPlayer.MainWindow"
        Title="MIDI 按键播放器（免费开源）"
        Width="1120" Height="960"
        MinWidth="980" MinHeight="880"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushCanvas}"
        FontFamily="{DynamicResource FontUi}"
        Closing="OnClosing">

  <Window.Styles>
    <!-- 文字色写死为深色，避免系统深色/高对比主题下白字白底看不见。
         带 class 的规则必须排在全量规则之后，否则会被盖掉。 -->
    <Style Selector="Window">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Window TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Window Button">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Window CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <!-- 弱化文字角色 -->
    <Style Selector="Window TextBlock.sectionLabel">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
    </Style>
    <Style Selector="Window TextBlock.caption">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
    </Style>
    <Style Selector="Window TextBlock.value">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
    </Style>
    <!-- 主按钮上的白字 -->
    <Style Selector="Window Button.accent">
      <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}"/>
    </Style>
  </Window.Styles>

  <!-- 打开入口是 SplitButton，它是 ContentControl，不是 Button：Styles\Controls.axaml 里的
       Button.accent 不适用。Fluent 主题里 SplitButton 用到的八个画刷键（键名见
       Avalonia.Themes.Fluent 的 SplitButton.xaml）改在 Styles\Theme.axaml 的主题字典里覆盖，
       深浅两套各指一份品牌绿。本窗口只有这一个 SplitButton。
       不这样做的话，按钮是 Fluent 默认的浅灰，颜色与主按钮不一致；放在窗口级资源里也不行 ——
       那里是 StaticResource，解析时不认主题变体，只有一套颜色。 -->

  <Grid>

    <!-- 左：文件/轨道；右：演奏控制 -->
    <DockPanel x:Name="MainBody" Margin="14">

    <!-- 最近一条消息。原来的一整块日志列表已经去掉：占地，且用户基本不看。
         完整历史仍然写进 %LOCALAPPDATA%\MidiKeyPlayer\play.log。 -->
    <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" Padding="10,4" CornerRadius="8"
            Background="{DynamicResource BrushSurfaceAlt}">
      <TextBlock x:Name="TxtLastMsg" FontSize="{DynamicResource FontCaption}"
                 Foreground="{DynamicResource BrushTextSecondary}"
                 TextTrimming="CharacterEllipsis" Text="就绪"/>
    </Border>

    <!-- 免责声明，点击关闭；确认过一次后写进设置，不再显示 -->
    <Border x:Name="DisclaimerBar" DockPanel.Dock="Bottom" Margin="0,12,0,0" Background="{DynamicResource BrushDangerSoft}"
            BorderBrush="{DynamicResource BrushDangerBorder}" BorderThickness="1" CornerRadius="10" Padding="12,8"
            PointerPressed="Disclaimer_PointerPressed" Cursor="Hand">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}"
                   Foreground="{DynamicResource BrushDangerText}" VerticalAlignment="Center">
          <Run FontWeight="Bold" Text="⚠ "/><Run Text="虚拟输入违反第三方软件规则，可能封号，风险自负"/>
        </TextBlock>
        <TextBlock Grid.Column="1" Text="✕" FontSize="{DynamicResource FontSmall}"
                   Foreground="{DynamicResource BrushDangerText}" Opacity="0.7"
                   Margin="12,0,2,0" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- ================= 左栏：文件 → 文件夹曲目 → 轨道 ================= -->
    <!-- 三行：打开卡 / 文件夹曲目卡（选过文件夹才可见）/ 轨道列表卡。
         文件夹曲目卡放在打开卡与轨道列表之间：用户点「打开文件夹…」之后，
         曲目就在这片常驻区域里，不用再去菜单里找。 -->
    <Grid Width="440" RowDefinitions="Auto,Auto,*" DockPanel.Dock="Left" Margin="0,0,12,0">

      <Border Grid.Row="0" Classes="card">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
          <!-- 打开入口：主体 = 文件选择对话框（一键，行为与旧按钮一样）；
               右侧箭头 = 菜单，只有两级（打开文件… / 打开文件夹… / 分隔线 / 最近打开 ▸）。
               菜单项全部由 RefreshRecentUi() 重建，见 MainWindow.axaml.cs。 -->
          <SplitButton x:Name="BtnOpen" Content="打开 MIDI 文件 / 文件夹" Click="BtnOpen_Click"
                       Padding="14,7" FontSize="{DynamicResource FontBody}" VerticalAlignment="Center"
                       ToolTip.Tip="点左边直接选文件；点右边的 ▾ 可以选文件夹（曲目列在下面那块区域），或从最近打开里挑">
            <SplitButton.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft"/>
            </SplitButton.Flyout>
          </SplitButton>
          <TextBlock Grid.Column="1" x:Name="LblFile" VerticalAlignment="Center"
                     Margin="12,0,0,0" Text="未选择文件" Classes="caption"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="sectionLabel" Margin="0,8,0,0"
                     Text="支持 .mid / .midi / .kar / .rmi"/>
        </Grid>
      </Border>

      <!-- ============ 文件夹曲目卡（常驻区域，选过文件夹才可见）============
           整块由 RefreshFolderUi()（MainWindow.axaml.cs）填内容与控制显隐：
           FolderList 里每一条都是代码建的 ListBoxItem（Tag = FolderRow(路径, 是否子文件夹)，
           悬浮提示 = 完整路径）。子文件夹排在文件前面，双击进入；MIDI 文件单击即载入，
           走 OpenFolderFileAsync —— 与「打开文件…」同一条链路，
           「有未导出手动改动要先确认」的保护照旧生效。
           没有「上一级」按钮（issue #57 去掉）：进子目录靠双击，回上层靠重新选目录。
           当前目录写进设置（AppConfig.FolderPath），重启后自动恢复这张卡；
           目录不在就留空隐藏，见 RestoreFolderFromConfig()。
           列表区固定 150px 高：曲目多少张，卡片高矮都不变，下面的轨道列表不会跟着跳；
           最多 50 行（子文件夹 + 文件），其余合并成一条不可点的说明。 -->
      <Border x:Name="FolderCard" Grid.Row="1" Classes="card" Margin="{DynamicResource CardGap}"
              Padding="12,10" IsVisible="False">
        <StackPanel Spacing="6">
          <!-- 标题行：文件夹名（过长省略）+ 「关闭」小按钮。两列，固定排版。 -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" x:Name="TxtFolderName" Text="" FontSize="{DynamicResource FontSmall}"
                       FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="当前列出曲目的文件夹"/>
            <Button x:Name="BtnFolderClose" Grid.Column="1" Content="关闭" Margin="8,0,0,0"
                    FontSize="{DynamicResource FontCaption}" Padding="10,3" Classes="secondary"
                    Click="FolderClose_Click"
                    ToolTip.Tip="收起这块区域，并清掉设置里记住的目录（下次启动不再出现）。磁盘上的文件不会被动"/>
          </Grid>

          <!-- 搜索：只按显示名（文件名 / 子文件夹名）匹配，不递归进子文件夹。清空就恢复整份列表。 -->
          <TextBox x:Name="TxtFolderSearch" FontSize="{DynamicResource FontCaption}"
                   Padding="6,3" Watermark="搜索曲目…"
                   TextChanged="FolderSearch_Changed"
                   ToolTip.Tip="按名字过滤下面的列表，留空显示全部。只搜当前文件夹，不进子文件夹"/>

          <!-- 固定高度 150：文件少时也留一块稳定区域，卡片高度不随曲目数量跳动。 -->
          <Grid Height="150">
            <!-- 列表：子文件夹在前（📁 前缀，双击进入），MIDI 文件在后（单击载入）。
                 条目由代码建，双击处理器只挂在子文件夹行上（见 BuildFolderItem）。
                 超过 FolderMenuMax 行时末尾有一条可点的「显示其余 N 项」，点开就全列出来。 -->
            <ListBox x:Name="FolderList" SelectionMode="Single" Background="Transparent"
                     SelectionChanged="FolderList_SelectionChanged"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0" Padding="0"/>
            <!-- 空文件夹（或搜索没命中）：这块卡仍然可见，方便用户直接换一个目录 -->
            <TextBlock x:Name="TxtFolderEmpty" IsVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,10"
                       Classes="caption" TextWrapping="Wrap" TextAlignment="Center"
                       Text="这个文件夹里没有找到 MIDI 文件或子文件夹。"/>
          </Grid>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Classes="card" Margin="{DynamicResource CardGap}" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <!-- 列头 -->
          <Border Classes="tableHead">
            <Grid ColumnDefinitions="22,24,28,62,*,56,42,70">
              <TextBlock Text="" FontSize="{DynamicResource FontMicro}"/>
              <TextBlock Grid.Column="1" Text="合" FontSize="{DynamicResource FontCaption}" Classes="sectionLabel"
                         Padding="2,7" FontWeight="SemiBold"
                         ToolTip.Tip="勾选多个声部一起演奏。编号=优先级，小的先演奏"/>
              <TextBlock Grid.Column="2" Text="轨" FontSize="{DynamicResource FontCaption}" Classes="sectionLabel"
                         Padding="4,7" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="3" Text="声道" FontSize="{DynamicResource FontCaption}" Classes="sectionLabel"
                         Padding="4,7" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="4" Text="名称" FontSize="{DynamicResource FontCaption}" Classes="sectionLabel"
                         Padding="4,7" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="5" Text="时长" FontSize="{DynamicResource FontCaption}" Classes="sectionLabel"
                         Padding="4,7" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="6" Text="音符" FontSize="{DynamicResource FontCaption}" Classes="sectionLabel"
                         Padding="4,7" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="7" Text="音域" FontSize="{DynamicResource FontCaption}" Classes="sectionLabel"
                         Padding="4,7" FontWeight="SemiBold"/>
            </Grid>
          </Border>
          <Grid Grid.Row="1">
            <ListBox x:Name="TrackList" SelectionMode="Single" Background="Transparent"
                     SelectionChanged="TrackList_SelectionChanged">
              <ListBox.Styles>
                <!-- 不适合乐器的轨道整行禁用 -->
                <Style Selector="ListBoxItem">
                  <Setter Property="IsEnabled" Value="{Binding IsPlayable}"/>
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="22,24,28,62,*,56,42,70" MinHeight="30">
                    <TextBlock Text="{Binding MixRank}" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource BrushInfoText}"
                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding IsMix}"/>
                    <TextBlock Text="●" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource BrushAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding ShowStar}"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding IsMix}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Checked="Mix_Changed" Unchecked="Mix_Changed"
                              ToolTip.Tip="勾选加入合奏，顺序就是编号"/>
                    <TextBlock Grid.Column="2" Text="{Binding TrackLabel}" VerticalAlignment="Center"
                               Padding="4,3" FontSize="{DynamicResource FontSmall}"/>
                    <TextBlock Grid.Column="3" Text="{Binding ChannelLabel}" VerticalAlignment="Center"
                               Padding="4,3" FontSize="{DynamicResource FontSmall}"/>
                    <TextBlock Grid.Column="4" Text="{Binding Name}" VerticalAlignment="Center"
                               Padding="4,3" FontSize="{DynamicResource FontSmall}" TextTrimming="CharacterEllipsis"
                               Foreground="{Binding VoiceBrush}"
                               ToolTip.Tip="{Binding Name}"/>
                    <TextBlock Grid.Column="5" Text="{Binding DurationText}" VerticalAlignment="Center"
                               Padding="4,3" FontSize="{DynamicResource FontCaption}" Classes="sectionLabel"/>
                    <TextBlock Grid.Column="6" Text="{Binding NoteCount}" VerticalAlignment="Center"
                               Padding="4,3" FontSize="{DynamicResource FontSmall}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="7" Text="{Binding RangeLabel}" VerticalAlignment="Center"
                               Padding="4,3" FontSize="{DynamicResource FontSmall}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <!-- 空状态引导 -->
            <TextBlock x:Name="EmptyHint" IsVisible="True"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                       Classes="caption" LineHeight="22"
                       Text="还没有载入曲目&#x0a;点「打开 MIDI 文件 / 文件夹」选一首，再点一行作为主旋律"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- ================= 右栏：演奏 ================= -->
    <Grid x:Name="RightColumn" RowDefinitions="Auto,*,Auto">

      <!-- 顶部一张卡：状态大字 + 当前主旋律信息。
           原来这是两张卡（状态一张、主旋律一张），各占一行却都只有一行字，
           纵向浪费明显，看着也碎。 -->
      <StackPanel Grid.Row="0">
        <Border x:Name="UpdateBanner" IsVisible="False" Classes="card"
                Margin="0,0,0,12" Padding="12,9" Background="{DynamicResource BrushInfoSoft}"
                BorderBrush="{DynamicResource BrushInfoBorder}"
                Cursor="Hand" PointerPressed="UpdateBanner_PointerPressed">
          <TextBlock x:Name="TxtUpdate" TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}"
                     Foreground="{DynamicResource BrushInfoText}"
                     LineHeight="20" Text=""/>
        </Border>
        <Border Classes="card">
          <StackPanel Spacing="3">
            <!-- 字号/颜色由代码按状态切换（倒计时时会放大） -->
            <TextBlock x:Name="LblStatus" FontSize="{DynamicResource FontTitle}" FontWeight="Bold"
                       Foreground="{DynamicResource BrushSuccess}"
                       TextAlignment="Center" Text="" TextWrapping="Wrap"/>
            <TextBlock x:Name="LblMelody" TextWrapping="Wrap" LineHeight="20"
                       FontSize="{DynamicResource FontBody}" TextAlignment="Center"
                       Text="打开 MIDI 文件，再在左侧点一行作为主旋律"/>
            <TextBlock x:Name="LblWarn" TextWrapping="Wrap" TextAlignment="Center"
                       FontSize="{DynamicResource FontSmall}" Text=""
                       PointerPressed="LblWarn_PointerPressed"
                       ToolTip.Tip="有音被跳过时，点这里看明细（哪些音、什么时间、什么原因）"/>
            <!-- UI-01 / UI-02：常驻的「有未导出改动」提示。手动改动只在内存里，
                 换歌与关窗都会丢弃，所以不能只靠「还原为自动」按钮变亮来暗示。 -->
            <TextBlock x:Name="TxtEditMark" IsVisible="False" TextWrapping="Wrap" TextAlignment="Center"
                       FontSize="{DynamicResource FontSmall}" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushWarn}"
                       Text="⚠ 有未导出的手动改动：改动只在内存里，换歌或关窗会丢弃。请先点「导出 MIDI…」保存。"/>

            <!-- 播放前自检：通过打勾、未通过打叉。这块原来收在设置的「常规」页里，
                 新人根本看不到；现在常驻在主界面状态卡里。不想要就在设置里关掉
                 （AppConfig.ShowPreflight，默认开）。控件只有这一份，设置页只留开关。 -->
            <StackPanel x:Name="PreflightRow" Spacing="2" Margin="0,6,0,0">
              <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BrushBorder}" Margin="0,0,0,5"/>
              <WrapPanel HorizontalAlignment="Center" ItemSpacing="14" LineSpacing="4">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                            ToolTip.Tip="仅当目标程序以管理员运行时才需要本程序同权（Windows 的 UIPI 限制）。普通目标程序不提权也能用">
                  <TextBlock x:Name="TxtCheckAdminMark" Text="–" FontSize="{DynamicResource FontBody}" FontWeight="Bold"
                             Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="TxtCheckAdmin" Text="管理员" FontSize="{DynamicResource FontSmall}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="BtnElevate" Content="以管理员重启" FontSize="{DynamicResource FontCaption}" Padding="10,3"
                        Classes="secondary" VerticalAlignment="Center" Click="BtnElevate_Click" IsVisible="False"
                        ToolTip.Tip="以管理员身份重新启动本程序：目标程序以管理员运行时才需要。未保存的手动改动请先导出"/>
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                            ToolTip.Tip="只有输入法开着并且处于中文/假名输入状态时才会截走按键。中文键盘布局切到英文模式可以直接用，不会误报">
                  <TextBlock x:Name="TxtCheckImeMark" Text="–" FontSize="{DynamicResource FontBody}" FontWeight="Bold"
                             Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="TxtCheckIme" Text="输入法" FontSize="{DynamicResource FontSmall}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="BtnRecheck" Content="刷新" FontSize="{DynamicResource FontCaption}" Padding="10,3"
                        Classes="secondary" VerticalAlignment="Center" Click="BtnRecheck_Click"
                        ToolTip.Tip="重新检测管理员权限与输入法状态（切换中英文模式后点一下即可）"/>
              </WrapPanel>
              <TextBlock x:Name="TxtCheckHint" IsVisible="False" Classes="caption"
                         Foreground="{DynamicResource BrushWarn}" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- ClipToBounds：窗口拉到最小高度时这张卡的高度会被压到内容需要的值以下，
           卡片里的子元素原来会画到自己格子之外（就是「卷帘盖住工具栏按钮」那条）。
           裁掉溢出，宁可少显示一点，也不许越界压别的控件。 -->
      <Border Grid.Row="1" Classes="card" Margin="{DynamicResource CardGap}" ClipToBounds="True">
        <!-- 外层两列：左=工具栏+卷帘+走带，右=用法说明。
             说明栏必须跨整张卡的高度，不能只跟卷帘同一行 —— 卷帘那一行只有几十像素高，
             说明会被裁得只剩开头几行，还得滚动才看得到。 -->
        <Grid ColumnDefinitions="*,Auto" ClipToBounds="True">
          <!-- 卷帘所在的格子（Grid.Row=1，`*`）。ClipToBounds 是这条遮挡的正面修复：
               格子被压小的时候卷帘原来会溢出到相邻的工具栏行上。 -->
          <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" ClipToBounds="True">
          <!-- 卷帘编辑工具栏。
               原来是单行横向 StackPanel：窗口拉到 MinWidth(980) 时右栏只剩约 470px，
               一行放不下十来个控件，末端的「缩小 / 放大 / 全曲」被挤出卡片右缘、显示不全。
               现在固定两行，并且**所有内容都放在 Auto 列，只留一个 * 空列吸收余量**——
               这样宽度不足时被压缩的是那片空白，而不是按钮本身（WrapPanel 放在 * 列里
               实测会「量出一行、摆进更窄的地方」从而直接裁掉末尾控件，不再使用）。 -->
          <Grid Grid.Row="0" RowDefinitions="Auto,Auto" Margin="0,0,0,6">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto">
              <TextBlock Grid.Column="0" Text="MIDI 编辑" Classes="sectionLabel"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="BtnUndo" Content="撤销" FontSize="{DynamicResource FontCaption}" Padding="10,3"
                        Classes="secondary" Click="Undo_Click" ToolTip.Tip="Ctrl+Z"/>
                <Button x:Name="BtnRedo" Content="重做" FontSize="{DynamicResource FontCaption}" Padding="10,3"
                        Classes="secondary" Click="Redo_Click" ToolTip.Tip="Ctrl+Y 或 Ctrl+Shift+Z"/>
                <Button x:Name="BtnDeleteNote" Content="删除所选" FontSize="{DynamicResource FontCaption}" Padding="10,3"
                        Classes="secondary" Click="DeleteNote_Click" ToolTip.Tip="也可以按 Delete 键，或右键点音符"/>
              </StackPanel>
              <!-- 缩放固定贴住卡片右缘，永远可见 -->
              <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock x:Name="TxtZoom" Classes="value" VerticalAlignment="Center" MinWidth="40"
                           TextAlignment="Right" Text="100%"
                           ToolTip.Tip="整首歌刚好铺满 = 100%"/>
                <Button x:Name="BtnZoomOut" Content="缩小" FontSize="{DynamicResource FontCaption}" Padding="10,3"
                        Classes="secondary" Click="ZoomOut_Click" ToolTip.Tip="也可以滚轮向下"/>
                <Button x:Name="BtnZoomIn" Content="放大" FontSize="{DynamicResource FontCaption}" Padding="10,3"
                        Classes="secondary" Click="ZoomIn_Click" ToolTip.Tip="也可以滚轮向上；Shift+滚轮左右平移；中键拖动平移"/>
                <Button x:Name="BtnZoomFit" Content="全曲" FontSize="{DynamicResource FontCaption}" Padding="10,3"
                        Classes="secondary" Click="ZoomFit_Click" ToolTip.Tip="缩放到整首歌"/>
              </StackPanel>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="BtnResetEdits" Content="还原为自动" FontSize="{DynamicResource FontCaption}" Padding="10,3"
                        Classes="secondary" Click="ResetEdits_Click" ToolTip.Tip="丢弃全部手动改动，回到自动提取的结果"/>
                <CheckBox x:Name="ChkSnap" Content="吸附 0.1s" IsChecked="True" VerticalAlignment="Center"
                          FontSize="{DynamicResource FontCaption}" IsCheckedChanged="Snap_Changed"
                          ToolTip.Tip="拖动与加音按 0.1 秒对齐。关掉可以自由摆位"/>
                <CheckBox x:Name="ChkFollow" Content="跟随播放" IsChecked="True" VerticalAlignment="Center"
                          FontSize="{DynamicResource FontCaption}"
                          ToolTip.Tip="播放时让卷帘自动跟着播放头滚动；手动滚轮或中键平移后会自动关掉"/>
                <Button x:Name="BtnExportMidi" Content="导出 MIDI…" FontSize="{DynamicResource FontCaption}" Padding="10,3"
                        Classes="secondary" Click="ExportMidi_Click"
                        ToolTip.Tip="把当前谱面（含你的改动）写成标准 MIDI 文件"/>
              </StackPanel>
              <!-- 帮助按钮贴在「还原为自动」这一行的最右端（正好在上一行「全曲」下面），
                   与其它按钮同样是框住文字的按钮，不是勾选框 -->
              <Button Grid.Column="1" x:Name="BtnHelp" Content="帮助"
                      FontSize="{DynamicResource FontCaption}" Padding="10,3" Margin="8,0,0,0"
                      Classes="secondary" Click="Help_Click"
                      ToolTip.Tip="在卷帘右侧显示操作说明。再点一下收起，把宽度让给卷帘"/>
            </Grid>
          </Grid>
          <!-- 卷帘：上=时间标尺，左=琴键栏。
               MinHeight 从 150 降到 90：窗口到最小高度（980x820）时右栏只有约 100px
               留给卷帘，150 放不下就会把卡片顶出格子。90 是标尺 20 + 两行琴键的可用下限。
               ClipToBounds 再兜一层：控制自身不越界画（PianoRoll 构造函数里也设了，这里写死更明确）。 -->
          <local:PianoRoll x:Name="Roll" Grid.Row="1" MinHeight="90" Margin="0,0,0,10"
                           ClipToBounds="True"
                           ToolTip.Tip="标尺拖动=定位；琴键栏点击=选中该音高；拖音符=移动；拖任一端=改长度；空白拖=框选；双击空白=加音；右键=删音；Ctrl+A 全选；Esc 清空；方向键微调"/>
          <Grid Grid.Row="2" RowDefinitions="Auto,Auto">
            <!-- 走带按钮与热键提示同一行。用 WrapPanel 而不是 Grid 的 Auto 列：
                 右栏在最小宽度下只有约 470px，"播放+停止+循环+热键提示" 加起来会超过它，
                 Grid 的 * 列被压到 0 之后子元素会互相压字（实测 f6 提示会盖住时间）。
                 WrapPanel 放不下就换行，永远不会重叠。 -->
            <WrapPanel Grid.Row="0" ItemSpacing="10" LineSpacing="6" VerticalAlignment="Center">
              <Button x:Name="BtnPlay" Content="▶ 播放 (F6)" Click="BtnPlay_Click"
                      Classes="accent" FontSize="{DynamicResource FontTitle}" Padding="20,8" IsEnabled="False"/>
              <Button x:Name="BtnStop" Content="■ 停止" Click="BtnStop_Click"
                      Classes="secondary" FontSize="{DynamicResource FontTitle}" Padding="20,8" IsEnabled="False"/>
              <!-- 试听：和「停止」一样大的独立按钮。只放声音，不发按键、不走倒计时、不最小化窗口。 -->
              <Button x:Name="BtnPreview" Content="试听" Click="Preview_Click"
                      Classes="secondary" FontSize="{DynamicResource FontTitle}" Padding="20,8"
                      ToolTip.Tip="用系统 MIDI 合成器直接播放当前谱面，不发送任何按键、不走倒计时、不最小化窗口。再点一下停止。"/>
              <CheckBox x:Name="ChkLoop" Content="循环" VerticalAlignment="Center" FontSize="{DynamicResource FontBody}"/>
              <TextBlock x:Name="TxtHotHint" Classes="sectionLabel" VerticalAlignment="Center"
                         Text="F6：开始 / 暂停 / 继续"/>
            </WrapPanel>
            <!-- 进度条单独一行。时间与定位音给固定宽度：文字一变宽就会挤动进度条，
                 播放时看起来就是"一抖一抖"。 -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
              <Slider x:Name="SliderProgress" VerticalAlignment="Center" Margin="0,0,10,0"
                      Minimum="0" Maximum="1" Value="0" IsEnabled="False"/>
              <TextBlock Grid.Column="1" x:Name="TxtTime" Classes="value" Width="112" TextAlignment="Right"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="0.0 / 0.0 s"/>
              <TextBlock Grid.Column="2" x:Name="TxtSeekNote" Classes="value" Width="128" Margin="12,0,0,0"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="—"/>
            </Grid>
          </Grid>
          </Grid>

          <!-- 帮助：跨整张卡的高度，紧挨卷帘右侧。工具栏的「帮助」按钮可收起。 -->
          <!-- UI-12：宽度 188 时装不下「左列操作 + 右列说明」，右列尾部被裁。
               加宽到 248，并把右列改成 Wrap 兜底：正常不换行，字体度量有出入时也不丢字。 -->
          <Border x:Name="RollHelp" Grid.Column="1" Width="248" Margin="12,0,0,0" Padding="10,8"
                  Background="{DynamicResource BrushSurfaceAlt}"
                  BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8">
            <Grid RowDefinitions="Auto,*">
              <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="怎么改谱" Classes="sectionLabel" FontWeight="SemiBold"
                           FontSize="{DynamicResource FontCaption}"/>
                <TextBlock FontSize="{DynamicResource FontCaption}" TextWrapping="Wrap" LineHeight="15"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           Text="卷帘颜色 = 左侧声轨列表的颜色，一轨一色。灰条 = 当前方案里没有对应的键，演奏与试听都会跳过。"/>
              </StackPanel>
              <!-- 一行一条：左列操作、右列作用。两列同一个 LineHeight，行与行自然对齐。 -->
              <ScrollViewer Grid.Row="1" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
                <Grid ColumnDefinitions="Auto,Auto">
                  <TextBlock Grid.Column="0" LineHeight="16" FontSize="{DynamicResource FontCaption}"
                             Foreground="{DynamicResource BrushText}" TextAlignment="Left"
                             Text="拖音符&#x0a;拖音符两端&#x0a;空白处拖&#x0a;双击空白&#x0a;右键&#x0a;点左侧琴键&#x0a;标尺点或拖&#x0a;方向键&#x0a;Delete&#x0a;Ctrl+A&#x0a;Esc&#x0a;Ctrl+Z / Y&#x0a;滚轮&#x0a;Shift+滚轮&#x0a;中键拖动"/>
                  <TextBlock Grid.Column="1" LineHeight="16" Margin="10,0,0,0" FontSize="{DynamicResource FontCaption}"
                             Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"
                             Text="移动（多选整组动）&#x0a;改长度（左改头右改尾）&#x0a;框选多个音符&#x0a;加一个音&#x0a;删音（可按住连擦）&#x0a;选中该音高全部音符&#x0a;定位播放位置&#x0a;微调（Shift 加速）&#x0a;删除所选&#x0a;全选&#x0a;清空选择&#x0a;撤销 / 重做&#x0a;缩放&#x0a;左右平移&#x0a;左右平移"/>
                </Grid>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- ================= 选项区（主界面右下角） =================
           原来整块是一张卡三行：速度/移调/设置入口挤在头一行，两个移调按钮独占一行却半空着，
           倒计时与两个勾选框又混在第三行 —— 一眼看不出哪几个管「怎么弹」、哪几个会改谱子。
           现在按「动的是什么」拆成两张卡，每张卡一行小标题：

             · 演奏参数：速度、移调、倒计时、播放后自动最小化 —— 只影响怎么弹，不改谱面；
             · 谱面调整：一键移调、自然音最多、去除开头空拍 —— 都会改谱面，卷帘里看得到。

           卡内用两列网格对齐：左列速度、倒计时，右列移调、播放后最小化，行与行的控件对得上。
           设置入口挪进标题行右端，方案名就贴在它左边（原来孤零零挂在滑块后面，看不出是什么）。
           控件名、ToolTip、事件处理器一律没改，代码里的引用照旧。 -->
      <StackPanel x:Name="OptionsArea" Grid.Row="2" Spacing="8" Margin="{DynamicResource CardGap}">

        <!-- 卡 1：演奏参数 -->
        <Border Classes="card" Padding="14,10">
          <StackPanel Spacing="8">

            <!-- 标题行：左=卡名，右=当前键位方案名 + 设置入口 -->
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="演奏参数" Classes="sectionLabel"
                         FontSize="{DynamicResource FontSmall}" FontWeight="SemiBold"
                         VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="TxtKeymapName" Classes="caption" MaxWidth="120" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="当前键位方案名"/>
                <Button x:Name="BtnSettings" Content="设置…" FontSize="{DynamicResource FontSmall}"
                        Padding="14,5" Classes="secondary" VerticalAlignment="Center" Click="Settings_Click"
                        ToolTip.Tip="打开设置：常规（设备、兼容、热键、导出、主界面显示）与键位（方案、按键绑定、功能键）两页"/>
              </StackPanel>
            </Grid>

            <!-- 两列网格：左列 = 速度 / 倒计时，右列 = 移调 / 播放后最小化。两行等距 -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
              <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="速度" Classes="label" MinWidth="34" VerticalAlignment="Center"/>
                <Slider x:Name="SliderSpeed" Width="96" Minimum="10" Maximum="400" Value="100"
                        TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SpeedChanged"
                        VerticalAlignment="Center"
                        ToolTip.Tip="10% = 慢速练习，400% = 快速过谱（引擎支持 10%–400%）"/>
                <TextBlock x:Name="TxtSpeed" Text="100%" Classes="value" Width="42" VerticalAlignment="Center"/>
              </StackPanel>

              <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
                <TextBlock Text="移调" Classes="label" MinWidth="34" VerticalAlignment="Center"/>
                <Slider x:Name="SliderTranspose" Width="96" Minimum="-24" Maximum="24" Value="0"
                        TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SpeedChanged"
                        VerticalAlignment="Center"
                        ToolTip.Tip="±24 半音（±2 个八度），与设置层、实时演奏同口径"/>
                <TextBlock x:Name="TxtTranspose" Text="0" Classes="value" Width="30" VerticalAlignment="Center"/>
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="倒计时" Classes="label" MinWidth="46" VerticalAlignment="Center"/>
                <ComboBox x:Name="CountdownCombo" Width="104" FontSize="{DynamicResource FontSmall}" SelectedIndex="1"
                          VerticalAlignment="Center" SelectionChanged="CountdownCombo_Changed"
                          ToolTip.Tip="点播放后等几秒才开始发按键：这段时间用来切到目标程序、装备乐器"/>
              </StackPanel>

              <!-- 「播放后自动最小化」只决定开始播放时缩不缩窗，不改谱面 -->
              <CheckBox Grid.Row="1" Grid.Column="1" x:Name="ChkAutoMinimize" Content="播放后自动最小化窗口"
                        FontSize="{DynamicResource FontSmall}" Margin="16,0,0,0"
                        IsChecked="True" VerticalAlignment="Center"
                        ToolTip.Tip="播放后窗口最小化。不勾选则保持原样（副屏看进度用，记得点一下目标窗口）"
                        IsCheckedChanged="AutoMinimize_Changed"/>

              <!-- 焦点守卫：键只进游戏。焦点离开目标程序就自动暂停，切回来自动继续 -->
              <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ChkFocusGuard"
                        Content="焦点离开目标程序时自动暂停（按键只进游戏）"
                        FontSize="{DynamicResource FontSmall}" IsChecked="True" VerticalAlignment="Center"
                        ToolTip.Tip="勾选后：演奏中焦点离开目标程序的窗口就自动暂停，切回去自动继续。Alt+Tab 出去不会把谱面弹进聊天窗口。与主程序自己的窗口交互不算离开"
                        IsCheckedChanged="FocusGuard_Changed"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- 卡 2：谱面调整。三个动作都会改当前谱面，与「演奏参数」分开。
             卡名与控件同一行：这张卡只有一行控件，再占一行标题就是白花竖排空间（卷帘要用）。 -->
        <Border Classes="card" Padding="14,10">
          <WrapPanel ItemSpacing="16" LineSpacing="8">
            <TextBlock Text="谱面调整" Classes="sectionLabel" MinWidth="52"
                       FontSize="{DynamicResource FontSmall}" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <Button x:Name="BtnAutoTranspose" Content="一键移调" FontSize="{DynamicResource FontSmall}"
                    Padding="12,5" Classes="secondary" VerticalAlignment="Center"
                    Click="BtnAutoTranspose_Click"
                    ToolTip.Tip="自动移调，让没有对应键的音最少（这些音会跳过不弹，卷帘里画成灰色）"/>

            <Button x:Name="BtnNaturalTranspose" Content="自然音最多" FontSize="{DynamicResource FontSmall}"
                    Padding="12,5" Classes="secondary" VerticalAlignment="Center"
                    Click="BtnNaturalTranspose_Click"
                    ToolTip.Tip="自动移调，让最多音落在自然音上（口琴等没有半音键的乐器用）。自然音同样多时取没有对应键的更少"/>

            <!-- 「去除开头空拍」会把整条旋律往前挪，属于改谱面 -->
            <CheckBox x:Name="ChkTrimLead" Content="去除开头空拍" FontSize="{DynamicResource FontSmall}"
                      IsChecked="True" VerticalAlignment="Center"
                      ToolTip.Tip="剪掉开头的休止，让旋律从第 0 秒开始。注意它会把整条旋律往前挪，卷帘左下角会标出剪掉了多少秒"
                      IsCheckedChanged="Option_Changed"/>
          </WrapPanel>
        </Border>

      </StackPanel>
    </Grid>
  </DockPanel>

  <!-- ================= 设置窗口「常规」页的实体内容（不在主界面显示） =================
       这块内容由「设置…」按钮搬进 SettingsWindow 的常规页显示，关窗再搬回来。
       为什么把 XAML 留在主窗：这些控件的 x:Name 与事件处理器都在 MainWindow.axaml.cs 里，
       搬走声明就要连带改几十处引用与处理器归属；留在原处则代码一行不动，
       控件实例也只有一个，不存在两份状态。
       藏法：外层 Border 不可见且零尺寸，内容在视觉树上但不参与布局。 -->
  <Border x:Name="AdvancedStash" IsVisible="False" Width="0" Height="0">
    <StackPanel x:Name="AdvancedBody" Spacing="10">

      <!-- MIDI 设备接入。演奏中这一行用不到；勾了「实时演奏」就直接开着，
           不勾不影响任何文件播放功能。 -->
      <Border Classes="card" Padding="14,10">
        <StackPanel Spacing="6">
          <TextBlock Text="设备接入" Classes="sectionLabel" FontSize="{DynamicResource FontSmall}"
                     FontWeight="SemiBold"/>
          <WrapPanel ItemSpacing="18" LineSpacing="8">
            <CheckBox x:Name="ChkMidiLive" Content="MIDI 设备实时演奏" FontSize="{DynamicResource FontSmall}"
                      VerticalAlignment="Center"
                      ToolTip.Tip="接上 MIDI 键盘或打击垫，按键直接发送到目标程序。不勾选时本程序完全不碰这个设备"
                      IsCheckedChanged="MidiLive_Changed"/>

            <StackPanel x:Name="PanelMidiControls" Orientation="Horizontal" Spacing="14"
                        IsVisible="False" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="设备" Classes="label" MinWidth="34"/>
                <ComboBox x:Name="MidiDeviceCombo" Width="190" FontSize="{DynamicResource FontSmall}"
                          VerticalAlignment="Center" SelectionChanged="MidiDevice_Changed"
                          ToolTip.Tip="系统里的 MIDI 输入设备。热插拔后点右边「刷新」"/>
                <Button x:Name="BtnMidiRefresh" Content="刷新" FontSize="{DynamicResource FontSmall}"
                        Padding="10,5" Classes="secondary" VerticalAlignment="Center"
                        Click="MidiRefresh_Click" ToolTip.Tip="重新扫描 MIDI 输入设备"/>
              </StackPanel>
              <TextBlock x:Name="TxtMidiStatus" Text="未启用" Classes="value" VerticalAlignment="Center"
                         Foreground="{DynamicResource BrushTextSecondary}"/>
            </StackPanel>

            <TextBlock x:Name="TxtMidiNoDevice" FontSize="{DynamicResource FontSmall}"
                       VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}"
                       Text="没有检测到 MIDI 设备。接上键盘或打击垫后点「刷新」。"/>
          </WrapPanel>

          <WrapPanel x:Name="PanelMidiOptions" ItemSpacing="18" LineSpacing="8" IsVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="基准八度" Classes="label" MinWidth="56"
                         ToolTip.Tip="乐器中音 do 所在的八度。设备上弹这个八度的 do 就是目标程序里的中音 do"/>
              <Slider x:Name="SliderMidiOctave" Width="110" Minimum="1" Maximum="6" Value="4"
                      TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                      ValueChanged="MidiOption_Changed"/>
              <TextBlock x:Name="TxtMidiOctave" Text="1" Classes="value" Width="52"/>
            </StackPanel>

            <CheckBox x:Name="ChkMidiAutoFit" Content="自动贴合音域" FontSize="{DynamicResource FontSmall}"
                      IsChecked="True" VerticalAlignment="Center"
                      ToolTip.Tip="按最近弹过的音自动挑基准八度。设备跨几个八度弹时，低音不会因为超出音域而不响"
                      IsCheckedChanged="MidiAutoFit_Changed"/>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="力度下限" Classes="label" MinWidth="56"
                         ToolTip.Tip="低于这个力度的音忽略。设备有抖动或触后噪声时调高"/>
              <Slider x:Name="SliderMidiVelocity" Width="110" Minimum="1" Maximum="127" Value="1"
                      TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                      ValueChanged="MidiOption_Changed"/>
              <TextBlock x:Name="TxtMidiVelocity" Text="1" Classes="value" Width="30"/>
            </StackPanel>
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- 输入兼容 + 三个热键 + 导出按键表 -->
      <Border Classes="card" Padding="14,10">
        <StackPanel Spacing="6">
          <TextBlock Text="按键发送与热键" Classes="sectionLabel" FontSize="{DynamicResource FontSmall}"
                     FontWeight="SemiBold"/>
          <WrapPanel ItemSpacing="22" LineSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="输入兼容" Classes="label"
                         ToolTip.Tip="目标程序按键是按帧读取的：修饰键与音键间隔太短会被折进同一帧，导致漏音。这里给出时间余量。"/>
              <ComboBox x:Name="TimingCombo" Width="150" FontSize="{DynamicResource FontSmall}"
                        VerticalAlignment="Center" SelectionChanged="Timing_Changed"
                        ToolTip.Tip="稳健=给30fps/掉帧留余量；标准=60fps 推荐；极限=高帧率下跟快歌。若仍漏音请选「稳健」。"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="输入方式" Classes="label"
                         ToolTip.Tip="SendInput 是 Windows 自带的输入模拟；罗技 G HUB 驱动则直接向罗技驱动发键盘报告。两种方式的兼容性不同，默认 SendInput 即可。"/>
              <ComboBox x:Name="BackendCombo" Width="216" FontSize="{DynamicResource FontSmall}"
                        VerticalAlignment="Center" SelectionChanged="Backend_Changed"
                        ToolTip.Tip="罗技 G HUB 驱动：直接向罗技驱动发标准键盘报告。需安装并保持运行 Logitech G HUB（不需要罗技硬件，装好后默认开机自启）。只发键盘：鼠标键无效；同时按住的音最多 6 个。"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="控制热键" Classes="label"
                         ToolTip.Tip="一个键四用：空闲=开始，播放=暂停，暂停=继续，倒计时=取消"/>
              <ComboBox x:Name="HotkeyControlCombo" Width="86" FontSize="{DynamicResource FontSmall}"
                        VerticalAlignment="Center" SelectionChanged="Hotkey_Changed"
                        ToolTip.Tip="默认 F6"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="后退热键" Classes="label"
                         ToolTip.Tip="按一下后退 5 秒。播放中跳转可能让目标程序侧乐器卡音"/>
              <ComboBox x:Name="HotkeyRewindCombo" Width="86" FontSize="{DynamicResource FontSmall}"
                        VerticalAlignment="Center" SelectionChanged="Hotkey_Changed"
                        ToolTip.Tip="默认 F5"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="前进热键" Classes="label"
                         ToolTip.Tip="按一下前进 5 秒。播放中跳转可能让目标程序侧乐器卡音"/>
              <ComboBox x:Name="HotkeyForwardCombo" Width="86" FontSize="{DynamicResource FontSmall}"
                        VerticalAlignment="Center" SelectionChanged="Hotkey_Changed"
                        ToolTip.Tip="默认 F7"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="上一首" Classes="label"
                         ToolTip.Tip="切到文件夹曲目里的上一首。要先「打开文件夹」列出曲目才生效；播放中切歌不走倒计时，直接接着弹"/>
              <ComboBox x:Name="HotkeyPrevCombo" Width="86" FontSize="{DynamicResource FontSmall}"
                        VerticalAlignment="Center" SelectionChanged="Hotkey_Changed"
                        ToolTip.Tip="默认 F8"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="下一首" Classes="label"
                         ToolTip.Tip="切到文件夹曲目里的下一首。要先「打开文件夹」列出曲目才生效；播放中切歌不走倒计时，直接接着弹"/>
              <ComboBox x:Name="HotkeyNextCombo" Width="86" FontSize="{DynamicResource FontSmall}"
                        VerticalAlignment="Center" SelectionChanged="Hotkey_Changed"
                        ToolTip.Tip="默认 F9"/>
            </StackPanel>

            <Button x:Name="BtnExport" Content="导出按键表 ▾" FontSize="{DynamicResource FontSmall}"
                    Padding="12,5" Classes="secondary" VerticalAlignment="Center" IsEnabled="False"
                    ToolTip.Tip="导出按键时序，与实际演奏一致">
              <Button.Flyout>
                <MenuFlyout Placement="Bottom">
                  <MenuItem Header="罗技 G HUB 脚本 (.lua)" Click="ExportGhub_Click"/>
                  <MenuItem Header="通用 CSV (.csv)" Click="ExportCsv_Click"/>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- 界面：皮肤与主界面上显示什么。播放前自检本体在主界面状态卡里（见上面的 PreflightRow），
           这里只有它的显示开关：不想要的人可以关掉，默认开。 -->
      <Border Classes="card" Padding="14,10">
        <StackPanel Spacing="6">
          <TextBlock Text="界面" Classes="sectionLabel" FontSize="{DynamicResource FontSmall}"
                     FontWeight="SemiBold"/>
          <WrapPanel ItemSpacing="20" LineSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="皮肤" Classes="label" MinWidth="34"/>
              <ComboBox x:Name="ThemeCombo" Width="152" FontSize="{DynamicResource FontSmall}"
                        SelectedIndex="0" VerticalAlignment="Center"
                        SelectionChanged="Theme_Changed"
                        ToolTip.Tip="自动 = 跟随 Windows 的浅色 / 深色设置。选完立即生效，不用重启"/>
            </StackPanel>
            <CheckBox x:Name="ChkShowPreflight" Content="播放前自检（管理员 / 输入法）"
                      FontSize="{DynamicResource FontSmall}" IsChecked="True" VerticalAlignment="Center"
                      IsCheckedChanged="ShowPreflight_Changed"
                      ToolTip.Tip="勾选时，主界面右上方的状态卡里常驻显示自检结论与「刷新」按钮。关掉后主界面不再显示这三样"/>
            <CheckBox x:Name="ChkOverlay" Content="播放悬浮窗（倒计时 / 进度）"
                      FontSize="{DynamicResource FontSmall}" IsChecked="True" VerticalAlignment="Center"
                      IsCheckedChanged="Overlay_Changed"
                      ToolTip.Tip="勾选时，倒计时与演奏期间在屏幕右上角显示一个置顶悬浮窗：倒计时秒数、进度条与当前音。浮窗可拖动，位置自动记忆"/>
            <CheckBox x:Name="ChkOverlayHideOnPause" Content="暂停后关闭悬浮窗"
                      FontSize="{DynamicResource FontSmall}" IsChecked="True" VerticalAlignment="Center"
                      IsCheckedChanged="OverlayHideOnPause_Changed"
                      ToolTip.Tip="勾选时，暂停也把悬浮窗收起来（不再挡着画面），继续演奏时自动弹回来，不用去设置里重开"/>
          </WrapPanel>
          <TextBlock Classes="caption" TextWrapping="Wrap" LineHeight="19"
                     Text="皮肤分浅色（白）与深色（黑），也可以跟随系统。自检常驻在主界面右上方的状态卡里，这里关掉就不再显示。悬浮窗浮在目标程序画面上，倒计时与演奏进度不用切回来看；暂停时默认把它收起来，继续时自动弹回，不想要可以在上面取消勾选。点悬浮窗右上角的 ✕ 只让本次播放不再弹它，设置里的开关不动。"/>
        </StackPanel>
      </Border>

      <!-- 关于：版本号、手动检查更新、内置文档查看。
           更新说明 / 第三方声明 / 许可证三份文本由 csproj 以 AvaloniaResource 嵌进 exe，
           这里提供界面入口；更新日志不进 exe（只随发布包附带），不在这里列。 -->
      <Border Classes="card" Padding="14,10">
        <StackPanel Spacing="6">
          <TextBlock Text="关于" Classes="sectionLabel" FontSize="{DynamicResource FontSmall}"
                     FontWeight="SemiBold"/>
          <WrapPanel ItemSpacing="14" LineSpacing="8">
            <TextBlock x:Name="TxtAboutVersion" Classes="label" VerticalAlignment="Center"/>
            <Button x:Name="BtnCheckUpdate" Content="检查更新" FontSize="{DynamicResource FontSmall}"
                    Padding="12,5" Classes="secondary" VerticalAlignment="Center"
                    Click="CheckUpdateManual_Click"
                    ToolTip.Tip="立刻检查 GitHub 上有没有新版本。有新版时主界面顶部会出现提示条"/>
            <Button Content="更新说明" FontSize="{DynamicResource FontSmall}" Tag="更新说明.txt"
                    Padding="12,5" Classes="secondary" VerticalAlignment="Center" Click="Doc_Click"/>
            <Button Content="第三方声明" FontSize="{DynamicResource FontSmall}" Tag="THIRD-PARTY-NOTICES.md"
                    Padding="12,5" Classes="secondary" VerticalAlignment="Center" Click="Doc_Click"/>
            <Button Content="许可证" FontSize="{DynamicResource FontSmall}" Tag="LICENSE"
                    Padding="12,5" Classes="secondary" VerticalAlignment="Center" Click="Doc_Click"/>
          </WrapPanel>
          <TextBlock Classes="caption" TextWrapping="Wrap" LineHeight="19"
                     Text="发现新版本时主界面顶部会出现提示条：点它自动下载并更新，右键跳过本版本。累积更新日志在发布包的 更新日志.txt 里。"/>
          <!-- 免费声明与作者链接：文案由代码从 AutoUpdate 的常量填（见 FillAboutLinks），
               避免同一个群号/链接在 XAML 与代码里各写一遍。 -->
          <Border Background="{DynamicResource BrushDangerSoft}" BorderBrush="{DynamicResource BrushDangerBorder}"
                  BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,3,0,0">
            <StackPanel Spacing="7">
              <TextBlock x:Name="TxtFreeNotice" TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}"
                         LineHeight="19" Foreground="{DynamicResource BrushDangerText}"/>
              <TextBlock x:Name="TxtAboutLinks" TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}"
                         LineHeight="19" Foreground="{DynamicResource BrushTextSecondary}"/>
              <WrapPanel ItemSpacing="10" LineSpacing="6">
                <Button x:Name="BtnAuthorSpace" Content="B 站主页" FontSize="{DynamicResource FontSmall}"
                        Padding="12,5" Classes="secondary" VerticalAlignment="Center"
                        Click="OpenAuthorSpace_Click"/>
                <Button x:Name="BtnCopyQq" Content="复制 QQ 群号" FontSize="{DynamicResource FontSmall}"
                        Padding="12,5" Classes="secondary" VerticalAlignment="Center"
                        Click="CopyQq_Click"/>
                <TextBlock x:Name="TxtQqCopied" Classes="caption" VerticalAlignment="Center" Text=""/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

    </StackPanel>
  </Border>

  <!-- 首次启动浮层。点「知道了」后写入设置，之后不再弹出。 -->
  <Border x:Name="QuickStartOverlay" IsVisible="False" Background="#66101828" CornerRadius="0">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="24">
      <Border Classes="card" Padding="24,20">
        <StackPanel Spacing="9">
          <TextBlock Text="快速上手" FontSize="17" FontWeight="Bold"/>
          <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontBody}" LineHeight="21"
                     Text="1. 打开 MIDI。在左侧点一行作为主旋律轨（选中的行带 ● 标记）。"/>
          <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontBody}" LineHeight="21"
                     Text="2. 按 F6 播放。倒计时结束前切到目标程序，装备乐器。"/>
          <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontBody}" LineHeight="21"
                     Text="3. F6 一个键四用：空闲开始，播放暂停，再按继续，倒计时取消。"/>
          <Border Background="{DynamicResource BrushWarnSoft}" BorderBrush="{DynamicResource BrushWarnBorder}"
                  BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,3,0,0">
            <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}" LineHeight="19"
                       Text="目标程序用窗口化。输入法切英文。没反应就先点一下目标窗口。"/>
          </Border>
          <Button x:Name="BtnQuickStartOk" Content="知道了" Classes="accent"
                  HorizontalAlignment="Right" Padding="18,7" FontSize="{DynamicResource FontTitle}" Margin="0,4,0,0"
                  Click="QuickStartOk_Click"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>

  <!-- 免费声明浮层：文案版本变了才弹一次（见 AutoUpdate.NoticeVersion 与设置里的 NoticeShownVersion）。
       正文与群号由代码从常量填。 -->
  <Border x:Name="FreeNoticeOverlay" IsVisible="False" Background="#66101828" CornerRadius="0">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="580" Margin="24">
      <Border Classes="card" Padding="24,20">
        <StackPanel Spacing="10">
          <TextBlock Text="本程序免费，别花钱买" FontSize="17" FontWeight="Bold"/>
          <TextBlock x:Name="TxtFreeNoticeBody" TextWrapping="Wrap"
                     FontSize="{DynamicResource FontBody}" LineHeight="21"/>
          <TextBlock x:Name="TxtFreeNoticeWhere" TextWrapping="Wrap"
                     FontSize="{DynamicResource FontSmall}" LineHeight="19"
                     Foreground="{DynamicResource BrushTextSecondary}"/>
          <WrapPanel ItemSpacing="10" LineSpacing="8">
            <Button Content="B 站主页" FontSize="{DynamicResource FontSmall}" Padding="12,5"
                    Classes="secondary" Click="OpenAuthorSpace_Click"/>
            <Button Content="复制 QQ 群号" FontSize="{DynamicResource FontSmall}" Padding="12,5"
                    Classes="secondary" Click="CopyQq_Click"/>
            <Button Content="打开下载页" FontSize="{DynamicResource FontSmall}" Padding="12,5"
                    Classes="secondary" Click="OpenReleases_Click"/>
          </WrapPanel>
          <Button x:Name="BtnFreeNoticeOk" Content="知道了" Classes="accent"
                  HorizontalAlignment="Right" Padding="18,7" FontSize="{DynamicResource FontTitle}" Margin="0,4,0,0"
                  Click="FreeNoticeOk_Click"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>

  <!-- 第一次使用的验证浮层：填对作者的 B 站 ID 才能进。
       只在设置里没答对过时弹一次（AppConfig.AuthorQuizPassed），以后每次更新都不再弹。 -->
  <Border x:Name="QuizOverlay" IsVisible="False" Background="#66101828" CornerRadius="0">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="580" Margin="24">
      <Border Classes="card" Padding="24,20">
        <StackPanel Spacing="10">
          <TextBlock Text="第一次使用，先回答一个问题" FontSize="17" FontWeight="Bold"/>
          <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontBody}" LineHeight="21"
                     Text="请输入作者的 B 站 ID（作者在 B 站的名字）。答对一次，以后不再问。"/>
          <Border Background="{DynamicResource BrushDangerSoft}" BorderBrush="{DynamicResource BrushDangerBorder}"
                  BorderThickness="1" CornerRadius="8" Padding="12,9">
            <TextBlock x:Name="TxtQuizRefund" TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSmall}" LineHeight="19"
                       Foreground="{DynamicResource BrushDangerText}"/>
          </Border>
          <WrapPanel ItemSpacing="10" LineSpacing="8">
            <TextBox x:Name="TxtQuizAnswer" Width="240" FontSize="{DynamicResource FontBody}"
                     Watermark="作者的 B 站 ID" KeyDown="QuizAnswer_KeyDown"/>
            <Button x:Name="BtnQuizOk" Content="确认" Classes="accent" Padding="18,7"
                    FontSize="{DynamicResource FontTitle}" Click="QuizConfirm_Click"/>
          </WrapPanel>
          <TextBlock x:Name="TxtQuizError" TextWrapping="Wrap" IsVisible="False"
                     FontSize="{DynamicResource FontSmall}" LineHeight="19"
                     Foreground="{DynamicResource BrushDangerText}"/>
          <WrapPanel ItemSpacing="10" LineSpacing="8">
            <Button Content="看作者的 B 站主页" FontSize="{DynamicResource FontSmall}" Padding="12,5"
                    Classes="secondary" Click="OpenAuthorSpace_Click"/>
            <Button Content="复制 QQ 群号" FontSize="{DynamicResource FontSmall}" Padding="12,5"
                    Classes="secondary" Click="CopyQq_Click"/>
            <Button Content="打开下载页" FontSize="{DynamicResource FontSmall}" Padding="12,5"
                    Classes="secondary" Click="OpenReleases_Click"/>
          </WrapPanel>
          <TextBlock x:Name="TxtQuizWhere" TextWrapping="Wrap"
                     FontSize="{DynamicResource FontSmall}" LineHeight="19"
                     Foreground="{DynamicResource BrushTextSecondary}"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>

  <!-- 强制更新浮层：当前版本低于 AutoUpdate.RequiredVersion 时盖住整个窗口。
       更新包自动开始下载；下载好之后点「重启并完成更新」。没有「稍后」「跳过」这类出路。 -->
  <Border x:Name="ForcedUpdateOverlay" IsVisible="False" Background="#CC0B1420" CornerRadius="0">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640" Margin="24">
      <Border Classes="card" Padding="24,20">
        <StackPanel Spacing="10">
          <TextBlock x:Name="TxtForcedTitle" FontSize="18" FontWeight="Bold"
                     Text="必须更新到最新版本"/>
          <TextBlock x:Name="TxtForcedBody" TextWrapping="Wrap"
                     FontSize="{DynamicResource FontBody}" LineHeight="21"/>
          <TextBlock x:Name="TxtForcedProgress" TextWrapping="Wrap"
                     FontSize="{DynamicResource FontSmall}" LineHeight="20"
                     Foreground="{DynamicResource BrushTextSecondary}"/>
          <Border Background="{DynamicResource BrushDangerSoft}" BorderBrush="{DynamicResource BrushDangerBorder}"
                  BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,3,0,0">
            <TextBlock x:Name="TxtForcedNotice" TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSmall}" LineHeight="19"
                       Foreground="{DynamicResource BrushDangerText}"/>
          </Border>
          <WrapPanel ItemSpacing="10" LineSpacing="8" Margin="0,2,0,0">
            <Button x:Name="BtnForcedApply" Content="重启并完成更新" Classes="accent"
                    Padding="18,7" FontSize="{DynamicResource FontTitle}" Click="ForcedApply_Click"/>
            <Button Content="手动下载（浏览器）" FontSize="{DynamicResource FontSmall}" Padding="12,5"
                    Classes="secondary" Click="ForcedManual_Click"/>
            <Button Content="B 站主页" FontSize="{DynamicResource FontSmall}" Padding="12,5"
                    Classes="secondary" Click="OpenAuthorSpace_Click"/>
            <Button Content="复制 QQ 群号" FontSize="{DynamicResource FontSmall}" Padding="12,5"
                    Classes="secondary" Click="CopyQq_Click"/>
            <Button Content="退出程序" FontSize="{DynamicResource FontSmall}" Padding="12,5"
                    Classes="secondary" Click="ForcedExit_Click"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</Grid>
</Window>
