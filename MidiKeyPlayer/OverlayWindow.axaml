<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MidiKeyPlayer.OverlayWindow"
        Title="MidiKeyPlayer 悬浮窗"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        FontFamily="{DynamicResource FontUi}">

  <Border x:Name="Card" CornerRadius="10" Padding="14,10"
          Background="#E6141820" BorderBrush="#40FFFFFF" BorderThickness="1"
          PointerPressed="Card_PointerPressed" PointerReleased="Card_PointerReleased">
    <Grid>
    <StackPanel Spacing="6">

      <StackPanel x:Name="PanelCountdown" Spacing="2" IsVisible="False" MinWidth="150">
        <TextBlock x:Name="TxtCountdown" Text="3" FontSize="38" FontWeight="Bold"
                   Foreground="#FFFFD166" HorizontalAlignment="Center"/>
        <TextBlock Text="秒后开始 · F6 可取消" FontSize="11" Foreground="#BFFFFFFF"
                   HorizontalAlignment="Center"/>
        <TextBlock x:Name="TxtCountdownNext" Text="" FontSize="11" Foreground="#BFFFFFFF"
                   HorizontalAlignment="Center" MaxWidth="250"
                   TextTrimming="CharacterEllipsis" IsVisible="False"/>
      </StackPanel>

      <StackPanel x:Name="PanelProgress" Spacing="5" Width="250" IsVisible="False">
        <Border CornerRadius="4" Background="#22FFFFFF" Height="90"
                ToolTip.Tip="迷你卷帘，黄线是当前位置">
          <Canvas x:Name="RollCanvas" Width="250" Height="90" ClipToBounds="True">
            <Canvas x:Name="RollContent">
              <Canvas.RenderTransform>
                <TranslateTransform X="0"/>
              </Canvas.RenderTransform>
            </Canvas>
            <Rectangle x:Name="Playhead" Width="1.5" Height="90" Fill="#FFFFD166"
                       Canvas.Left="62" ZIndex="1"/>
          </Canvas>
        </Border>
        <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Value="0" Height="5"
                     Foreground="#FF4CAF7D" Background="#33FFFFFF"/>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="TxtTime" Text="0.0 / 0.0 s" FontSize="11" Foreground="#BFFFFFFF"/>
          <TextBlock x:Name="TxtState" Grid.Column="1" Text="" FontSize="11"
                     Foreground="#FFFFD166"/>
        </Grid>
        <TextBlock x:Name="TxtQueue" Text="" FontSize="11" Foreground="#BFFFFFFF"
                   TextTrimming="CharacterEllipsis" IsVisible="False"/>
      </StackPanel>

    </StackPanel>

    <Button x:Name="BtnOverlayOff" Content="✕" Click="BtnOverlayOff_Click"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-11,0"
            Padding="5,1" FontSize="10" Focusable="False"
            Background="Transparent" BorderThickness="0" Foreground="#80FFFFFF"
            ToolTip.Tip="只关本次播放，下次还会出现"/>
    </Grid>
  </Border>
</Window>
