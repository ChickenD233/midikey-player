<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MidiKeyPlayer.SettingsWindow"
        Title="设置"
        Width="640" Height="660"
        MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushCanvas}"
        FontFamily="{DynamicResource FontUi}"
        PointerPressed="Window_PointerPressed"
        Closed="Window_Closed">

  <Window.Styles>
    <!-- 与主窗同一套文字色规则：避免系统深色 / 高对比主题下白字白底看不见 -->
    <Style Selector="Window">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Window TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Window Button">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Window CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Window TextBlock.sectionLabel">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
    </Style>
    <Style Selector="Window TextBlock.caption">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
    </Style>
    <Style Selector="Window TextBlock.value">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
    </Style>
    <Style Selector="Window TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Window TextBlock.danger">
      <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
    </Style>
    <Style Selector="Window TextBlock.link">
      <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- 键帽方块：整块就是一个按钮，左键点哪里都是「改这个键的绑定」。
         改音高放在右键菜单里，不切方块、不占左键面积。 -->
    <Style Selector="Button.capBlock">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="Padding" Value="6,3,16,0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!-- 平时不画底色，只有悬停 / 按下时给一点提示；虚线描边由按钮自己承担 -->
    <Style Selector="Button.capBlock /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.capBlock:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
    </Style>
    <Style Selector="Button.capBlock:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
    </Style>
    <Style Selector="Button.capClose /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="5"/>
    </Style>
    <Style Selector="Button.capClose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushDangerSoft}"/>
    </Style>
    <Style Selector="Button.capClose:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
    </Style>

    <!-- 行尾与行下的「+」：整个方框都是点击区。
         虚线画在按钮自己的 BorderBrush 上，不要另放 Rectangle：按钮本体必须占满方框。 -->
    <Style Selector="Button.rowPlus">
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="{DynamicResource FontTitle}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    </Style>
    <Style Selector="Button.rowPlus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.rowPlus:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
    </Style>
    <Style Selector="Button.rowPlus:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
    </Style>
    <Style Selector="Button.rowPlusWide">
      <Setter Property="FontSize" Value="{DynamicResource FontCaption}"/>
    </Style>
  </Window.Styles>

  <!-- 三页：常规（设备、兼容、热键、导出、自检）、键位（方案、按键绑定、功能键）、赞助（爱发电与作者链接）。
       常规页的内容由 MainWindow 在打开时搬进来（AdvancedHost），键位页与赞助页的控件就声明在这里。
       窗口大小跟着页签走：常规页小、键位页大，见 SettingsWindow.axaml.cs 的 ApplyPageSize。 -->
  <DockPanel>

    <!-- 底部：一句话说明 + 关闭。设置即时生效，没有「应用」按钮 -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="10" Margin="14,8,14,12">
      <TextBlock Classes="caption" VerticalAlignment="Center"
                 Text="改动即时生效，关掉本窗口不影响设置。"/>
      <Button Content="关闭" Classes="secondary" Padding="18,6" Click="CloseSettings_Click"/>
    </StackPanel>

    <TabControl x:Name="Pages" SelectionChanged="Pages_SelectionChanged"
                Background="Transparent" Padding="0" Margin="10,8,10,0">
      <TabItem Header="常规">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ContentControl x:Name="AdvancedHost" Margin="6,10,6,6"/>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="键位">
  <Grid RowDefinitions="*,Auto">

    <ScrollViewer Grid.Row="0" x:Name="MainScroll"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="14,12,14,8" Spacing="8">

        <!-- ============ 1. 方案行 ============ -->
        <Border Classes="card">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="方案" Classes="label" VerticalAlignment="Center"/>
              <ComboBox x:Name="KeymapCombo" Width="175" FontSize="{DynamicResource FontSmall}"
                        VerticalAlignment="Center" SelectionChanged="KeymapCombo_Changed"
                        ToolTip.Tip="当前正在用的键位方案。改完自动存"/>
              <Button x:Name="BtnNewScheme" Content="新建方案…" Classes="secondary"
                      FontSize="{DynamicResource FontCaption}" Padding="8,1" VerticalAlignment="Center"
                      Click="SchemeNew_Click"
                      ToolTip.Tip="以当前方案为底复制一份新方案，马上可以改名字"/>
              <Button x:Name="BtnRenameScheme" Content="改名…" Classes="secondary"
                      FontSize="{DynamicResource FontCaption}" Padding="8,1" VerticalAlignment="Center"
                      Click="SchemeRename_Click"
                      ToolTip.Tip="给这套方案换个名字"/>
              <Button Content="导入方案…" Classes="secondary" FontSize="{DynamicResource FontCaption}"
                      Padding="8,1" VerticalAlignment="Center" Click="KeymapImport_Click"
                      ToolTip.Tip="读入一个方案 JSON 文件"/>
              <Button Content="导出方案…" Classes="secondary" FontSize="{DynamicResource FontCaption}"
                      Padding="8,1" VerticalAlignment="Center" Click="KeymapExport_Click"
                      ToolTip.Tip="把当前方案写成 JSON 文件"/>
              <Button x:Name="BtnSchemeMenu" Content="管理 ▾" Classes="secondary"
                      FontSize="{DynamicResource FontCaption}" Padding="8,1" MinWidth="28"
                      VerticalAlignment="Center" ToolTip.Tip="删除方案、恢复默认设置">
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft">
                    <MenuItem x:Name="MiSchemeDelete" Header="删除方案…" Click="SchemeDelete_Click"
                              ToolTip.Tip="删掉这套方案，内置方案不能删"/>
                    <Separator/>
                    <MenuItem x:Name="MiSchemeRestore" Header="恢复默认设置…" Click="SchemeRestore_Click"
                              ToolTip.Tip="把当前方案的键位改回初始键位。不影响你的其他方案"/>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
            <TextBlock x:Name="TxtSchemeHint" Classes="caption" TextWrapping="Wrap"
                       Foreground="{DynamicResource BrushInfoText}" Text=""/>
          </StackPanel>
        </Border>

        <!-- ============ 2. 按键绑定：一行一行排，行内不换行 ============ -->
        <Border Classes="card">
          <StackPanel Spacing="6">
            <!-- 标题右边一句说明：键帽上不再写唱名，八度只靠上下点表示 -->
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="按键绑定" Classes="sectionLabel" FontWeight="SemiBold"
                         VerticalAlignment="Center"/>
              <TextBlock Classes="caption" VerticalAlignment="Center"
                         Text="数字上方的点 = 高音，下方的点 = 低音。左键点键帽 = 改绑按键，右键键帽 = 改音高或解绑"/>
            </StackPanel>

            <!-- 一条绑都没有时的灰字说明。加行按钮只留下面那一个（曾经这里还有一个「+ 新建第一行」，与它重复） -->
            <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding ShowEmptyHint}"
                       Text="还没有绑任何键。点下面的「+ 加一行」开始：一行从左到右是 do re mi fa sol la si，键名会自动填好。"/>

            <ItemsControl x:Name="BindRows" HorizontalAlignment="Stretch">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="2" Margin="0,0,0,6">
                    <TextBlock Text="{Binding Label}" Classes="caption"/>
                    <!-- 一行键帽 + 行尾「+」：横向滚动，绝不换行。
                         「+」就在最后一个键帽的正右边（同一个横向容器里），不是另起一列。 -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <ItemsControl ItemsSource="{Binding Cells}" HorizontalAlignment="Left">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid Width="76" Height="58" Margin="0,0,6,0">
                                <!-- 整块键帽就是一个按钮：左键点方块的任何位置都进入「按一个键」等待态。
                                     大字是音高（数字上下的点表示八度），下沿是当前绑的键名。
                                     等待中按钮内容换成「按一个键…」。右上角只留解绑的「✕」。
                                     右键弹这个键自己的菜单（改音高… / 解绑这个键），左键不受影响。 -->
                                <Border CornerRadius="8" BoxShadow="0 1 2 0 #140F1729"
                                        Background="{DynamicResource BrushSurface}"
                                        BorderBrush="{Binding BlockBorderBrush}"
                                        BorderThickness="{Binding BlockBorderThickness}">
                                  <Grid>
                                    <Button Classes="capBlock" Click="BlockKey_Click"
                                            ContextRequested="CapBlock_ContextRequested"
                                            BorderBrush="{DynamicResource BrushBorderStrong}"
                                            BorderThickness="1" CornerRadius="8" Padding="6,3,6,4"
                                            ToolTip.Tip="{Binding CapTip}">
                                      <Grid RowDefinitions="*,Auto">
                                        <TextBlock Grid.Row="0" Text="{Binding PitchName}" VerticalAlignment="Top"
                                                   FontSize="{DynamicResource FontSmall}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushText}"/>
                                        <TextBlock Grid.Row="1" Text="{Binding KeyCapText}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                   FontSize="{DynamicResource FontCaption}"
                                                   Foreground="{Binding KeyCapForeground}"/>
                                      </Grid>
                                    </Button>
                                    <!-- 右上角：解绑 -->
                                    <Button Classes="capClose" Content="✕" Click="RowRemove_Click"
                                            Width="16" Height="16" Padding="0" FontSize="10"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            ToolTip.Tip="解绑这个音"/>
                                  </Grid>
                                </Border>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- 行尾「+」：在这一行末尾加一个音（列），紧跟在最后一个键帽右边 -->
                        <Button Classes="rowPlus" Width="34" Height="58" Margin="2,0,0,0"
                                Content="+" Click="RowAddCell_Click"
                                ToolTip.Tip="在这一行末尾加一个音（列）"/>
                      </StackPanel>
                    </ScrollViewer>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 最后一行下面的「+」：新增一行，音高比上一行高一个八度。整个方框都是点击区 -->
            <StackPanel x:Name="AddRowPanel" Orientation="Horizontal" Spacing="8">
              <Button Classes="rowPlus rowPlusWide" Width="110" Height="32"
                      Content="+ 加一行" Click="RowAddRow_Click"
                      ToolTip.Tip="在最下面新增一行，音高比上一行高一个八度"/>
              <TextBlock Classes="caption" VerticalAlignment="Center"
                         Text="行尾的「+」加一个音，这里的「+」加一整行（高一个八度）。行太长时左右滚动看。"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ============ 3. 功能键（带启用开关） ============ -->
        <Border Classes="card">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0" Text="功能键（让手上的键弹出多个音）"
                         Classes="sectionLabel" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <CheckBox Grid.Column="1" x:Name="ChkModifiers" Content="启用功能键"
                        FontSize="{DynamicResource FontSmall}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" IsChecked="True" Click="Modifiers_Changed"
                        ToolTip.Tip="不勾时：下面三个键都不生效，超出键位范围的音直接不发声，不做八度折叠"/>
            </Grid>
            <StackPanel x:Name="FuncPanel" Spacing="4">
              <ItemsControl x:Name="FuncRows">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                      <TextBlock Grid.Column="0" Width="78" Text="{Binding Label}"
                                 Classes="label" VerticalAlignment="Center"/>
                      <!-- 绑法与键帽一样：点一下，再按一个键。不再有「选键名」下拉 -->
                      <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto">
                        <Border Grid.Column="0" CornerRadius="{DynamicResource RadiusControl}"
                                BorderThickness="{Binding WaitBorderThickness}"
                                BorderBrush="{Binding WaitBorderBrush}">
                          <Button Width="130" FontSize="{DynamicResource FontSmall}" Padding="4,2"
                                  HorizontalContentAlignment="Center" Classes="secondary"
                                  Content="{Binding KeyCapText}"
                                  Foreground="{Binding KeyCapForeground}"
                                  Click="FuncKey_Click"
                                  ToolTip.Tip="点一下，再按一个键，就把这个功能绑到这个键。Shift、Ctrl、Alt 单独按一下再松开也行"/>
                        </Border>
                        <Button Grid.Column="1" Content="✕" Width="24" Margin="6,0,0,0"
                                Padding="0" FontSize="{DynamicResource FontMicro}"
                                HorizontalContentAlignment="Center" Classes="secondary"
                                Click="FuncClear_Click" ToolTip.Tip="不用这个功能键，点了以后显示「未绑」"/>
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- 常驻统计行 -->
    <Border Grid.Row="1" Padding="12,6" Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatsText}" Classes="caption" TextWrapping="Wrap"/>
    </Border>
  </Grid>
      </TabItem>

      <!-- ============ 赞助页 ============
           爱发电排在最上面（整页最显眼的一块），下面才是 B 站、GitHub 与 QQ 群。
           地址与名字由代码从 AutoUpdate 的常量填（见 SettingsWindow.FillSponsorPage），
           免得同一个链接在 XAML 与代码里各写一遍。
           「程序完全免费」这类声明只留在「常规」页的关于卡里，这一页不重复。 -->
      <TabItem Header="赞助">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="14,12,14,10" Spacing="10">

            <!-- 爱发电。整块是暖色底，一眼就看到 -->
            <Border Background="{DynamicResource BrushWarnSoft}"
                    BorderBrush="{DynamicResource BrushWarnBorder}" BorderThickness="1"
                    CornerRadius="10" Padding="16,14">
              <StackPanel Spacing="10">
                <TextBlock Text="爱发电" Classes="label" FontSize="{DynamicResource FontTitle}"
                           FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" LineHeight="20"
                           FontSize="{DynamicResource FontSmall}"
                           Text="赞助完全自愿，不影响任何功能。"/>
                <TextBlock x:Name="TxtSponsorAfdianUrl" Classes="value" TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSmall}"/>
                <Button x:Name="BtnSponsorAfdian" Content="打开爱发电赞助页"
                        FontSize="{DynamicResource FontTitle}" Padding="20,8"
                        Classes="accent" HorizontalAlignment="Left"
                        Click="OpenAfdian_Click"/>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="作者的其它地方" Classes="sectionLabel" FontWeight="SemiBold"
                           FontSize="{DynamicResource FontSmall}"/>
                <!-- 三个按钮一行：B 站、GitHub、复制群号。地址不进正文，鼠标停在按钮上看 -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="BtnSponsorBili" Content="B 站主页"
                          FontSize="{DynamicResource FontSmall}" Padding="12,5"
                          Classes="secondary" Click="OpenBili_Click"/>
                  <Button x:Name="BtnSponsorGitHub" Content="GitHub 主页"
                          FontSize="{DynamicResource FontSmall}" Padding="12,5"
                          Classes="secondary" Click="OpenGitHub_Click"/>
                  <Button x:Name="BtnSponsorCopyQq" Content="复制群号"
                          FontSize="{DynamicResource FontSmall}" Padding="12,5"
                          Classes="secondary" Click="CopyQq_Click"/>
                  <TextBlock x:Name="TxtSponsorQqCopied" Classes="caption" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============ 实验功能页 ============
           远程同演：几个人各自选自己的声部，一同演奏同一首 MIDI。
           同步只管两件事：谁弹哪个声部、从什么时候开始。按键全部由本机发出。
           时间靠本机单调时钟的锚点，不比较两台机器的墙钟，所以不用对时。
           传输走自建的中转站（cloudflare/ 目录里的 Worker），不走公共代理。
           这一页的逻辑在 SettingsWindow.Experimental.cs。
           中间那块「成员表」与「声部」用 ItemsControl 绑 ObservableCollection，
           不在代码里手工拼控件 —— 成员进出与声部变动是随时变的。 -->
      <TabItem Header="实验功能">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="14,12,14,10" Spacing="10">

            <!-- 顶上的定位说明。实验功能会改行为，先说清楚它是什么。
                 连接之后就收起来：房间卡里该有的都有，留着它只会把这页底部的
                 「下一步做什么」与演出按钮挤到滚动条外面（那两样才是要看的）。 -->
            <Border Classes="card" Padding="12,10" x:Name="SyncIntroCard">
              <StackPanel Spacing="4">
                <TextBlock Text="远程同演（实验功能）" Classes="label"
                           FontSize="{DynamicResource FontTitle}" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" LineHeight="19"
                           FontSize="{DynamicResource FontSmall}"
                           Text="几个人各自选自己的声部，一同演奏同一首 MIDI。联机只同步「什么时候开始弹」与「谁弹哪个声部」。"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="caption" FontSize="{DynamicResource FontMicro}"
                             VerticalAlignment="Center"
                             Text="试验阶段。中转站走 Cloudflare，消息加密。"/>
                  <Button x:Name="BtnSyncIntro" Content="怎么看这个功能" Classes="secondary"
                          FontSize="{DynamicResource FontMicro}" Padding="8,2"
                          Click="SyncIntro_Click"/>
                </StackPanel>
                <TextBlock x:Name="TxtSyncIntro" TextWrapping="Wrap" LineHeight="18"
                           FontSize="{DynamicResource FontMicro}" Classes="caption" IsVisible="False"
                           Text="每个人先自己导入一首 MIDI，再进同一个房间。房主填房间名与密码，点「创建房间」，把邀请串发给朋友；朋友粘进「加入房间」就进来了。声部各人选自己的。房主点「开演」时，全场倒数几秒之后同时开始 —— 倒数是在等各人的电脑收到信号，网络快的人等得久一点，所以大家落在同一拍上。不需要对时，也不需要公网 IP。"/>
              </StackPanel>
            </Border>

            <!-- ===== 未连接：建房 / 加入 ===== -->
            <Border Classes="card" x:Name="SyncConnectCard">
              <StackPanel Spacing="8">
                <TextBlock Text="连接" Classes="sectionLabel" FontWeight="SemiBold"
                           FontSize="{DynamicResource FontSmall}"/>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="我的名字" Classes="label" VerticalAlignment="Center" Width="64"/>
                  <TextBox x:Name="TxtSyncName" Width="180" FontSize="{DynamicResource FontSmall}"
                           Watermark="例如 小明"
                           ToolTip.Tip="同房间其他人看到的名字。不填就用本机用户名"/>
                  <TextBlock Text="倒数" Classes="label" VerticalAlignment="Center"/>
                  <ComboBox x:Name="CmbSyncCountdown" Width="86" FontSize="{DynamicResource FontSmall}"
                            SelectionChanged="SyncCountdown_Changed"
                            ToolTip.Tip="房主点开演之后等几秒开始。这几秒是用来等各人的电脑收到信号的">
                    <ComboBoxItem Content="2 秒"/>
                    <ComboBoxItem Content="3 秒"/>
                    <ComboBoxItem Content="5 秒"/>
                    <ComboBoxItem Content="10 秒"/>
                    <ComboBoxItem Content="15 秒"/>
                  </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="房间名" Classes="label" VerticalAlignment="Center" Width="64"/>
                  <TextBox x:Name="TxtSyncRoom" Width="180" FontSize="{DynamicResource FontSmall}"
                           Watermark="例如 小明的琴房"
                           ToolTip.Tip="自己取一个。朋友用这个房间名加密码进你的房间"/>
                  <TextBlock Text="密码" Classes="label" VerticalAlignment="Center"/>
                  <TextBox x:Name="TxtSyncPass" Width="140" FontSize="{DynamicResource FontSmall}"
                           Watermark="自己定" PasswordChar="●"
                           ToolTip.Tip="自己定一个。第一次创建房间时用哪个密码，以后进这个房间就得用哪个"/>
                  <Button x:Name="BtnSyncHost" Content="创建房间" Classes="accent"
                          FontSize="{DynamicResource FontSmall}" Padding="16,6"
                          Click="SyncHost_Click"/>
                </StackPanel>

                <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0"
                        Margin="0,2,0,0" Padding="0,8,0,0">
                  <StackPanel Spacing="6">
                    <TextBlock Text="加入房间" Classes="label" FontSize="{DynamicResource FontSmall}"/>
                    <TextBox x:Name="TxtSyncInvite" FontSize="{DynamicResource FontSmall}"
                             AcceptsReturn="False" TextWrapping="NoWrap"
                             Watermark="把朋友发来的邀请串粘在这里（一整行）"
                             ToolTip.Tip="邀请串形如 mkp://中转站|房间名|密码。一次粘贴，三样都带上"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button x:Name="BtnSyncJoin" Content="加入" Classes="secondary"
                              FontSize="{DynamicResource FontSmall}" Padding="16,5"
                              Click="SyncJoin_Click"/>
                      <TextBlock x:Name="TxtSyncJoinHint" Classes="caption" VerticalAlignment="Center"
                                 FontSize="{DynamicResource FontMicro}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- 中转站地址。默认收起：发布版会内置一个，用户不用管 -->
                <Expander Header="高级：中转站地址" FontSize="{DynamicResource FontSmall}">
                  <StackPanel Spacing="6" Margin="0,6,0,0">
                    <TextBox x:Name="TxtSyncBroker" FontSize="{DynamicResource FontSmall}"
                             Watermark="midikeyplayer-sync.你的名字.workers.dev"
                             ToolTip.Tip="你自己部署的 Cloudflare Worker 地址。开头不用写 https://，结尾不用写斜杠"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="18" Classes="caption"
                               FontSize="{DynamicResource FontMicro}"
                               Text="这是房主创建房间时用的地址。加入房间时以邀请串里带的地址为准，这里的填写不影响。"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="18" Classes="caption"
                               FontSize="{DynamicResource FontMicro}"
                               Text="连不上先查这些：浏览器打开「地址/health」看是不是 ok；地址有没有多写 https:// 或结尾斜杠；密码是不是与第一次创建房间时一致。"/>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>

            <!-- ===== 已连接：房间状态 ===== -->
            <Border Classes="card" x:Name="SyncRoomCard" IsVisible="False">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Grid.Column="0" Text="房间" Classes="sectionLabel"
                             FontWeight="SemiBold" FontSize="{DynamicResource FontSmall}"
                             VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" x:Name="TxtSyncStatus" Classes="value" Margin="10,0,0,0"
                             FontSize="{DynamicResource FontSmall}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"/>
                  <Button Grid.Column="2" x:Name="BtnSyncLeave" Content="退出房间" Classes="secondary"
                          FontSize="{DynamicResource FontMicro}" Padding="10,4"
                          Click="SyncLeave_Click"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" x:Name="SyncInviteRow">
                  <TextBlock x:Name="TxtSyncInviteShown" Classes="value" FontSize="{DynamicResource FontMicro}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                  <Button x:Name="BtnSyncCopyInvite" Content="复制邀请串" Classes="secondary"
                          FontSize="{DynamicResource FontMicro}" Padding="10,4"
                          Click="SyncCopyInvite_Click"
                          ToolTip.Tip="把这一整行发给朋友，他们粘进「加入房间」就能进来"/>
                  <TextBlock x:Name="TxtSyncCopied" Classes="caption" VerticalAlignment="Center"
                             FontSize="{DynamicResource FontMicro}"/>
                </StackPanel>

                <!-- 曲目指纹：只做本机提示，不做联网核对 -->
                <TextBlock x:Name="TxtSyncTrack" Classes="caption" TextWrapping="Wrap"
                           FontSize="{DynamicResource FontMicro}"/>

                <!-- 成员表 -->
                <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0"
                        Padding="0,8,0,0">
                  <StackPanel Spacing="4">
                    <TextBlock Text="成员" Classes="label" FontSize="{DynamicResource FontSmall}"/>
                    <ItemsControl x:Name="SyncPeerList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid ColumnDefinitions="14,180,140,90,*" Margin="0,1">
                            <TextBlock Grid.Column="0" Text="{Binding Mark}" FontSize="{DynamicResource FontMicro}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="label"
                                       FontSize="{DynamicResource FontSmall}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding Voices}" Classes="value"
                                       FontSize="{DynamicResource FontSmall}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="3" Text="{Binding Transpose}" Classes="value"
                                       FontSize="{DynamicResource FontSmall}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{Binding ReadyText}" Classes="caption"
                                       FontSize="{DynamicResource FontMicro}" VerticalAlignment="Center"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- 我的声部：各人选自己的，程序不做占用检查 -->
                <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0"
                        Padding="0,8,0,0">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Grid.Column="0" Text="我的声部" Classes="label"
                                 FontSize="{DynamicResource FontSmall}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" x:Name="TxtSyncAssignHint" Classes="caption"
                                 FontSize="{DynamicResource FontMicro}" Margin="10,0,0,0"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                 Text="自己勾。别人勾了同一个也看得见，重了你们自己商量。"/>
                    </Grid>
                    <ItemsControl x:Name="SyncVoiceList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                            <CheckBox IsChecked="{Binding IsMine}" Content="{Binding Label}"
                                      FontSize="{DynamicResource FontSmall}"
                                      Click="SyncVoiceToggle_Click"
                                      ToolTip.Tip="{Binding Tip}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- 我的移调 -->
                <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0"
                        Padding="0,8,0,0">
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="我的移调" Classes="label" FontSize="{DynamicResource FontSmall}"
                                 VerticalAlignment="Center" Width="64"/>
                      <Slider x:Name="SliderSyncTranspose" Minimum="-24" Maximum="24"
                              TickFrequency="1" IsSnapToTickEnabled="True" Width="240"
                              ValueChanged="SyncTranspose_Changed"
                              ToolTip.Tip="半音。每个人各管各的"/>
                      <TextBlock x:Name="TxtSyncTranspose" Classes="value" FontSize="{DynamicResource FontSmall}"
                                 VerticalAlignment="Center" Width="40"/>
                      <Button x:Name="BtnSyncUnifyTranspose" Content="统一为这个值" Classes="secondary"
                              FontSize="{DynamicResource FontMicro}" Padding="10,4"
                              Click="SyncUnifyTranspose_Click"
                              ToolTip.Tip="把这个移调规定给全场。别人会跟着改"/>
                      <Button x:Name="BtnSyncClearTranspose" Content="取消统一" Classes="secondary"
                              FontSize="{DynamicResource FontMicro}" Padding="10,4"
                              Click="SyncClearTranspose_Click"
                              ToolTip.Tip="取消统一，各人回到自己设的移调"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- 演出控制。原来「开演 / 暂停 / 继续 / 跳转 / 停止」五个按钮平铺一行：
                     暂停与继续互斥却并排摆着，暂停之后要在一排长得差不多的按钮里找「继续」；
                     成员那几个按钮全是灰的，只知道自己按不动、不知道该怎么办。
                     现在只留一个跟着状态变的主按钮（开演 → 暂停 → ▶ 继续 → 重新开演），
                     跳转与停止压成次要按钮；成员看到的是右边那行「由房主控制」，不再给一排灰按钮。 -->
                <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0"
                        Padding="0,8,0,0">
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <CheckBox x:Name="ChkSyncReady" Content="我就绪了" FontSize="{DynamicResource FontSmall}"
                                Click="SyncReady_Click"
                                ToolTip.Tip="房主要看到所有人都就绪才好开演"/>
                      <Button x:Name="BtnSyncPrimary" Content="开演" Classes="accent"
                              FontSize="{DynamicResource FontSmall}" Padding="18,5"
                              Click="SyncPrimary_Click"
                              ToolTip.Tip="按当前状态来：没开演就是开演，演奏中就是暂停，暂停中就是继续"/>
                      <Button x:Name="BtnSyncSeek" Content="跳转" Classes="secondary"
                              FontSize="{DynamicResource FontMicro}" Padding="12,4"
                              Click="SyncSeek_Click"
                              ToolTip.Tip="跳到本机进度条当前的位置，全场一起跳。先拖主界面的进度条定位置"/>
                      <Button x:Name="BtnSyncStop" Content="停止" Classes="secondary"
                              FontSize="{DynamicResource FontMicro}" Padding="12,4"
                              Click="SyncStop_Click"
                              ToolTip.Tip="本轮演出到此为止，全场一起停。之后可以「重新开演」"/>
                      <TextBlock x:Name="TxtSyncMemberControl" IsVisible="False" VerticalAlignment="Center"
                                 Classes="caption" FontSize="{DynamicResource FontMicro}"
                                 Text="演出由房主控制：暂停 / 继续 / 跳转 / 停止"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtSyncSpeed" Classes="caption"
                               FontSize="{DynamicResource FontMicro}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <TextBlock x:Name="TxtSyncHint" Classes="caption" TextWrapping="Wrap"
                           FontSize="{DynamicResource FontMicro}"/>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
